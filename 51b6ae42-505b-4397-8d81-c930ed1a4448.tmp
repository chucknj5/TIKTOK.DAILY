<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TikTok W.E. Report</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
<style id="tt-style">
:root{
  --bg:#f4f5f7; --panel:#fff; --ink:#16181d; --mute:#6b7280; --line:#e3e5ea;
  --brand:#351c15; --accent:#f5b400; --good:#0f7b4b; --bad:#c0362c; --soft:#fafbfc;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
header{background:var(--brand);color:#fff;padding:12px 20px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
header h1{font-size:17px;margin:0;letter-spacing:.5px;font-weight:700}
header h1 span{color:var(--accent)}
header .sp{flex:1}
.savestat{font-size:12px;color:#c9f0d6;font-weight:600}.savestat.bad{color:#ffb4ab}
header label{font-size:11px;text-transform:uppercase;letter-spacing:.6px;opacity:.8;display:flex;flex-direction:column;gap:2px}
header select,header input{background:#4a2a20;color:#fff;border:1px solid #6b4436;border-radius:6px;padding:5px 8px;font:inherit}
button{font:inherit;border:1px solid var(--line);background:#fff;border-radius:6px;padding:6px 12px;cursor:pointer;font-weight:600}
button.pri{background:var(--accent);border-color:var(--accent);color:#1a1a1a}
button:hover{filter:brightness(.96)}
button:disabled{opacity:.45;cursor:not-allowed}
header button{border-color:#6b4436;background:#4a2a20;color:#fff}
header button.pri{background:var(--accent);color:#1a1a1a;border-color:var(--accent)}
main{padding:16px 20px;max-width:1400px;margin:0 auto}
#drop{border:2px dashed #b9bec8;border-radius:12px;background:var(--panel);text-align:center;padding:60px 20px;color:var(--mute);cursor:pointer;transition:.15s}
#drop.small{padding:12px;font-size:13px}
#drop.over{border-color:var(--accent);background:#fffbea;color:var(--ink)}
#drop b{color:var(--ink);font-size:16px}
#drop.small b{font-size:13px}
.files{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
.chip{background:#fff;border:1px solid var(--line);border-radius:20px;padding:3px 10px;font-size:12px;display:flex;gap:6px;align-items:center}
.chip x{cursor:pointer;color:var(--bad);font-weight:700}
.sitebar{display:none;flex-wrap:wrap;gap:6px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:10px;padding:8px 10px;margin:6px 0}
.sitebar b{font-size:11px;letter-spacing:.6px;color:var(--brand);margin-right:4px}
.sc{border:1px solid var(--line);border-radius:6px;padding:4px 10px;cursor:pointer;font-weight:700;font-size:13px;background:#f1f2f4;color:var(--mute);user-select:none;display:flex;flex-direction:column;line-height:1.15}
.sc small{font-weight:500;font-size:10px}
.unas{flex-basis:100%;font-size:12px;background:#fff4e5;border:1px solid #f5c27a;border-radius:6px;padding:6px 8px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.unas select{font:inherit;padding:2px 4px}
.sc.on{background:var(--brand);color:#fff;border-color:var(--brand)}
.sc.all{background:#fff;color:var(--ink);justify-content:center}
.mvbox{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;background:var(--soft);border:1px solid var(--line);border-radius:8px;padding:10px 12px;margin-bottom:8px}
.mvbox label,#dlg label{display:flex;flex-direction:column;font-size:11px;font-weight:700;letter-spacing:.5px;color:var(--mute);gap:3px}
.mvbox select,.mvbox input,#dlg input{font:inherit;padding:6px 8px;border:1px solid var(--line);border-radius:6px;min-width:200px;color:var(--ink)}
.hint{font-size:12px;color:var(--mute);flex-basis:100%}
.mini{padding:2px 8px;font-size:12px}
.mini.x{color:var(--bad)}
.tag{font-size:10px;background:#e0f2e9;color:var(--good);border-radius:4px;padding:1px 5px;font-weight:700}
.issues{display:grid;grid-template-columns:repeat(auto-fit,minmax(520px,1fr));gap:12px;margin-bottom:8px}
.ibox{border:2px solid var(--line);border-radius:8px;background:#fff;padding:10px}
.ibox.open{border-color:#f5c27a;background:#fffaf0}
.ihd{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:6px}
.ihd .cnt{font-size:12px;color:var(--mute)}.ihd .thr{font-size:12px;color:var(--mute);margin-left:auto}
.ihd .thr input{width:44px;padding:2px 4px;border:1px solid var(--line);border-radius:4px;font:inherit}
.itbl td,.itbl th{font-size:12px;padding:4px 6px}
.itbl th{background:var(--brand)}
.itbl td:nth-child(2){text-align:left}
.itbl td input{width:72px}
tr.okrow td{background:#f0faf4}
.bdg{display:inline-block;background:var(--bad);color:#fff;border-radius:9px;font-size:10px;padding:0 6px;margin-left:5px;vertical-align:middle}
.netbox{background:#fff;border:2px solid var(--brand);border-radius:8px;padding:10px;margin:0 0 10px}
.netbox tr.chg td{background:#fffbea}
.tag.rm{background:#fde2e1;color:var(--bad)}
.tag.t2{background:#fff3c4;color:#8a6100}
.rb td input{width:80px}
.rb .netok{color:var(--good);font-weight:800}.rb .netbad{color:var(--bad);font-weight:800}
.plan{border:2px solid var(--accent);border-radius:8px;padding:10px;margin:8px 0;background:#fffdf3}
.plan .bar{display:flex;gap:8px;align-items:center;margin-top:8px;flex-wrap:wrap}
tr.mv td{background:#f3fbf6}
table.log td{font-size:13px}
table.log th:nth-child(2),details th:nth-child(2){text-align:left}
.flt{margin:4px 0 8px;padding:6px 8px;border:1px solid var(--line);border-radius:6px;width:260px;font:inherit}
#dlg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);align-items:center;justify-content:center;z-index:9}
#dlg .card{background:#fff;border-radius:12px;padding:18px;width:min(420px,92vw);display:flex;flex-direction:column;gap:8px;box-shadow:0 10px 40px rgba(0,0,0,.25)}
#dlg input{min-width:0;width:100%}
.sheet{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px;margin-bottom:12px}
.rhead{display:grid;grid-template-columns:minmax(200px,1.6fr) 80px 1.4fr;grid-template-rows:auto auto;border:2px solid #000;margin-bottom:10px;max-width:900px}
.rhead>div{border:1px solid #000;display:flex;align-items:center;justify-content:center;font-weight:700}
.rlogo{grid-row:1/3;padding:8px 12px}.rlogo img{max-width:100%;max-height:78px}
.rlab{font-size:12px}.rsite{font-size:28px;letter-spacing:.5px;padding:10px}.rdate{font-size:15px;padding:6px}
.rsub{color:var(--mute);font-size:12px;margin:-4px 0 10px}
table.orig{border:2px solid #000}
table.orig th{background:#fff;color:#000;border:1px solid #000;font-size:11px;padding:8px 6px;text-align:center}
table.orig td{border:1px solid #000;text-align:center;font-weight:600;height:34px}
table.orig td:first-child{text-align:center;font-weight:800}
table.orig tr.tot td{background:#fff2cc}
table.orig tr.zero td{color:#9aa0a8;font-weight:500}
textarea.notes{min-height:110px;border:2px solid #000;border-radius:0}
.tabs{display:flex;gap:4px;flex-wrap:wrap;margin:14px 0 0;border-bottom:2px solid var(--brand)}
.tab{padding:8px 14px;border-radius:8px 8px 0 0;background:#e6e8ec;cursor:pointer;font-weight:700;font-size:13px;color:var(--mute);user-select:none}
.tab.has{color:var(--ink);background:#fff3c4}
.tab.on{background:var(--brand);color:#fff}
.tab small{display:block;font-weight:500;font-size:10px;opacity:.8}
.panel{background:var(--panel);border:1px solid var(--line);border-top:0;border-radius:0 0 10px 10px;padding:16px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.kpi{background:var(--soft);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
.kpi .l{font-size:11px;text-transform:uppercase;color:var(--mute);letter-spacing:.5px}
.kpi .v{font-size:22px;font-weight:800;font-variant-numeric:tabular-nums}
.ttl{display:flex;align-items:baseline;gap:10px;margin:0 0 10px}
.ttl h2{margin:0;font-size:18px}
.ttl .m{color:var(--mute);font-size:13px}
table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}
th,td{border:1px solid var(--line);padding:6px 8px;text-align:right;white-space:nowrap}
th{background:var(--brand);color:#fff;font-size:11px;text-transform:uppercase;letter-spacing:.4px}
td:first-child,th:first-child{text-align:left}
tr.tot td{background:#fff3c4;font-weight:800}
tr.zero td{color:#a3a8b2}
td input{width:90px;border:1px solid var(--line);border-radius:4px;padding:3px 5px;text-align:right;font:inherit}
.neg{color:var(--bad);font-weight:700}
.ot{color:#b45309;font-weight:700}
.scroll{overflow-x:auto}
details{margin-top:14px;border:1px solid var(--line);border-radius:8px;background:var(--soft)}
details summary{padding:9px 12px;cursor:pointer;font-weight:700}
details .in{padding:0 12px 12px;max-height:520px;overflow:auto}
details table td,details table th{font-size:12px;padding:4px 7px}
textarea{width:100%;min-height:60px;border:1px solid var(--line);border-radius:6px;padding:8px;font:inherit;margin-top:6px}
.warn{background:#fff4e5;border:1px solid #f5c27a;border-radius:8px;padding:8px 12px;margin:10px 0;font-size:13px}
.grid2{display:grid;grid-template-columns:1fr;gap:14px}
h3{font-size:13px;text-transform:uppercase;letter-spacing:.6px;margin:18px 0 8px;color:var(--brand)}
.pos{color:var(--good)}
@media print{
  header button,#drop,.files,.sitebar,details,.noprint{display:none!important}
  .tabs{display:none} body{background:#fff} .panel{border:0}
  td input{border:0}
}
</style>
</head>
<body>
<div id="app">
<header>
  <h1>TIKTOK <span>W.E.</span> REPORT</h1>
  <label>Site Name<input id="siteName" value="TIKTOK" size="10"></label>
  <label>Week Ending<select id="week"></select></label>
  <div class="sp"></div>
  <span id="saveStat" class="savestat"></span>
  <button id="btnShared" title="Shared save — everyone with the link sees the same data">⚙ SHARED</button>
  <button id="btnSaveHtml" title="Download this page with all the data saved inside it">SAVE HTML</button>
  <button class="pri" id="btnSave" title="Save all loaded days, edits, handshake/volume and notes in this browser">SAVE</button>
  <button id="btnBackup" title="Download a backup file of all saved days (drop it back in to restore)">BACKUP</button>
  <button id="btnPrint">PRINT</button>
  <button id="btnClear">CLEAR</button>
  <button class="pri" id="btnXlsx">EXPORT EXCEL</button>
</header>
<main>
  <div id="drop"><b>DROP PUNCH REPORT(S) HERE</b><br>Punch_Report CSV / XLSX — one per day, or drop the whole week at once<br><small>or click to browse</small></div>
  <input type="file" id="fi" multiple accept=".csv,.xlsx,.xls,.json,.html" hidden>
  <div class="files" id="files"></div>
  <div class="sitebar" id="sitebar"></div>
  <div id="view"></div>
  <div id="dlg"></div>
</main>
</div>

<script id="tt-main">
/* ---------- in-page confirm / ask / toast (browser pop-ups can be blocked) ---------- */
function ask(msg,okTxt,cb,input){
  const dlg=document.getElementById('dlg');
  dlg.innerHTML=`<div class="card"><div style="font-weight:700;white-space:pre-line">${String(msg).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</div>${input?`<input id="askIn" type="date" value="${input}">`:''}
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:10px"><button id="askNo">CANCEL</button><button class="pri" id="askYes">${okTxt||'OK'}</button></div></div>`;
  dlg.style.display='flex';const close=()=>{dlg.style.display='none';dlg.onclick=null};
  document.getElementById('askNo').onclick=close;dlg.onclick=e=>{if(e.target===dlg)close()};
  document.getElementById('askYes').onclick=()=>{const v=input?document.getElementById('askIn').value:true;close();if(!input||v)cb(v)};
}
window.alert=m=>{let t=document.getElementById('toast');if(!t){t=document.createElement('div');t.id='toast';t.style.cssText='position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#351c15;color:#fff;padding:10px 16px;border-radius:8px;font-weight:600;z-index:20;max-width:90vw;box-shadow:0 6px 20px rgba(0,0,0,.3)';document.body.appendChild(t)}t.textContent=m;t.style.display='block';clearTimeout(t._h);t._h=setTimeout(()=>t.style.display='none',4500)};
const BUCKETS=['FORKLIFT','LEAD','GENERAL LABOR'];
const DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const SITE_NAMES={'TT':'TIKTOK'};
const S={files:[],inputs:{},sites:new Set(),seen:new Set(),week:null,tab:null};
// inputs[key][bucket] = {hs,vol,inv}; inputs[key]._notes

const LS=(k,d)=>{try{return Object.assign(d,JSON.parse(localStorage.getItem(k)||'{}'))}catch(e){return d}};
const LSs=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}};
const DEPT_DEF={'100':'LEAD','200':'FORKLIFT','300':'GENERAL LABOR'}; // TikTok punch report dept codes
let DEPTMAP=LS('tt_deptmap',{...DEPT_DEF});
Object.entries(DEPT_DEF).forEach(([c,b])=>{if(!DEPTMAP[c])DEPTMAP[c]=b});   // dept code -> FORKLIFT / LEAD / GENERAL
const PAY_DEF={'FORKLIFT':23,'LEAD':25,'GENERAL LABOR':20},MU_DEF=28.5;
let LRATE=LS('tt_payrates',{...PAY_DEF});   // line -> PAY rate $/hr (bill = pay × (1 + markup))
let MU=LS('tt_markup',{pct:MU_DEF});
const billOf=pay=>num(pay)*(1+num(MU.pct)/100);
// migrate older saved settings that used GENERAL
Object.keys(DEPTMAP).forEach(k=>{if(DEPTMAP[k]==='GENERAL')DEPTMAP[k]='GENERAL LABOR'});
function nameLine(dept){ // dept named in the punch report
  const u=String(dept||'').toUpperCase();
  if(/LEAD|SUPERVIS/.test(u))return'LEAD';
  if(/FORK|\bPIT\b|REACH|LIFT/.test(u))return'FORKLIFT';
  if(/GEN|LABOR/.test(u))return'GENERAL LABOR';
  return null;
}
function bucketOf(dept){
  const dk=String(dept||'').trim(),mp=DEPT_DEF[dk]||DEPTMAP[dk];if(mp&&BUCKETS.includes(mp))return mp;
  return nameLine(dept)||'GENERAL LABOR';
}
// departments with no 2-digit code: map them to a site (saved in this browser)
const DEF_ALIAS={};
let ALIAS=(()=>{try{return Object.assign({},DEF_ALIAS,JSON.parse(localStorage.getItem('tt_site_alias')||'{}'))}catch(e){return{...DEF_ALIAS}}})();
const saveAlias=()=>{try{localStorage.setItem('tt_site_alias',JSON.stringify(ALIAS))}catch(e){}};
const siteOf=d=>{const t=String(d||'').trim(),m=t.match(/^(\d{2})/);return m?m[1]:(ALIAS[t.toUpperCase()]||'TT')};
function resite(){S.files.forEach(f=>f.rows.forEach(r=>r.site=siteOf(r.dept)))}
const num=v=>{if(v==null||v==='')return 0;const n=parseFloat(String(v).replace(/[$,\s]/g,''));return isNaN(n)?0:n};
const f2=n=>n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
const $m=n=>(n<0?'-$':'$')+f2(Math.abs(n));
const hr=n=>n?f2(n):'–';
const DRX=/\d{1,2}\/\d{1,2}\/\d{4}|\d{4}-\d{2}-\d{2}/g;
const pd=s=>{s=String(s);let m=s.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);if(m)return new Date(+m[3],m[1]-1,+m[2]);m=s.match(/(\d{4})-(\d{2})-(\d{2})/);return m?new Date(+m[1],m[2]-1,+m[3]):null};
const iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const mdy=d=>String(d.getMonth()+1).padStart(2,'0')+'.'+String(d.getDate()).padStart(2,'0')+'.'+d.getFullYear();
const weSat=d=>{const x=new Date(d);x.setDate(x.getDate()+((7-x.getDay())%7));return x}; // week ending = SUNDAY (work week Mon–Sun)
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

/* ---------- file loading ---------- */
const drop=document.getElementById('drop'),fi=document.getElementById('fi');
drop.onclick=()=>fi.click();
fi.onchange=e=>{load([...e.target.files]);fi.value=''};
['dragenter','dragover'].forEach(t=>document.addEventListener(t,e=>{e.preventDefault();drop.classList.add('over')}));
['dragleave','drop'].forEach(t=>document.addEventListener(t,e=>{e.preventDefault();if(t==='drop'||e.target===drop)drop.classList.remove('over')}));
document.addEventListener('drop',e=>load([...e.dataTransfer.files]));

async function load(list){
  for(const f of list){
    try{
      if(/\.json$/i.test(f.name)){const b=norm(JSON.parse(await f.text()));if(b){apply(merge(payload(),b));alert('Backup merged in.')}continue}
      if(/\.html?$/i.test(f.name)){const m=(await f.text()).match(/<script type="application\/json" id="tt-state">([\s\S]*?)<\/script>/);if(m){apply(merge(payload(),JSON.parse(m[1])));alert('Data from '+f.name+' merged in.')}else alert('No saved data in '+f.name);continue}
      const buf=await f.arrayBuffer();
      const wb=XLSX.read(buf,{type:'array',raw:true});
      // a workbook may hold several TS sheets (e.g. an old W.E. file) — take every sheet that has the timecard header
      let any=false;
      for(const sn of wb.SheetNames){
        const aoa=XLSX.utils.sheet_to_json(wb.Sheets[sn],{header:1,defval:'',raw:false});
        const p=parse(aoa,f.name+(wb.SheetNames.length>1?' › '+sn:''));
        if(p){[].concat(p).forEach(add);any=true}
      }
      if(!any)alert('No punch report data found in '+f.name+' (looking for an EMP L NAME header).');
    }catch(err){alert('Could not read '+f.name+': '+err.message)}
  }
  render();
}
const hm=v=>{v=String(v||'').trim();if(!v)return null;let m=v.match(/(-?\d+):(\d{2})/);if(m)return(+m[1])+(m[1].startsWith('-')?-1:1)*(+m[2])/60;const n=parseFloat(v);return isNaN(n)?null:n};
const tmin=v=>{const m=String(v||'').trim().match(/^(\d{1,2}):(\d{2})\s*([AP])?M?$/i);if(!m)return null;let h=+m[1]%12;if(m[3]&&m[3].toUpperCase()==='P')h+=12;if(!m[3])h=+m[1];return h*60+(+m[2])};
const tshort=v=>String(v||'').trim().replace(/^0/,'').replace(/\s*([AP])M$/i,(x,a)=>a.toLowerCase());
function parse(aoa,name){
  const hi=aoa.findIndex(r=>r.some(c=>String(c).trim().toUpperCase()==='EMP L NAME'));
  if(hi<0)return null;
  const H=aoa[hi].map(h=>String(h).trim().toUpperCase()),col=k=>H.indexOf(k);
  const c={ln:col('EMP L NAME'),fn:col('EMP F NAME'),id:col('EMP##'),date:col('DATE'),in:col('IN'),out:col('OUT'),tot:col('TOTAL'),dept:col('DEPT CODE')};
  let hd=null;for(let i=0;i<hi;i++){const ds=String(aoa[i].join(' ')).match(DRX);if(ds){hd=pd(ds[0]);break}}
  // 1) read every punch line, grouped by person + day (all depts, file order)
  const blank=v=>{v=String(v||'').trim();return /^[-–—_.:\s*]*$/.test(v)?'':v};
  const pd2={};let seq=0;
  for(let i=hi+1;i<aoa.length;i++){
    const r=aoa[i],L=String(r[c.ln]||'').replace(/\s+/g,' ').trim(),Fn=String(r[c.fn]||'').replace(/\s+/g,' ').trim();
    if(!L&&!Fn)continue;if(/^TOTAL/i.test(L))continue;
    const nm=L&&Fn?L+', '+Fn:L||Fn,d=pd(r[c.date])||hd;if(!d)continue;
    const code=String(r[c.dept]||'').trim()||'NO DEPT',ti=blank(r[c.in]),to=blank(r[c.out]);
    if(!ti&&!to&&hm(r[c.tot])==null)continue;
    const pk=iso(d)+'|'+nm.toUpperCase();(pd2[pk]=pd2[pk]||{d:iso(d),name:nm,id:String(r[c.id]||'').trim(),segs:[]}).segs.push({code,ti,to,tot:hm(r[c.tot]),n:seq++});
  }
  // 2) missing lunch punches: join the halves into one straight shift so the hours still count
  //    IN-only + OUT-only → IN→OUT · IN-only + IN/OUT → first IN→OUT · IN/OUT + OUT-only → IN→last OUT
  Object.values(pd2).forEach(p=>{const S2=p.segs;
    for(let n=0;n<S2.length-1;n++){const a=S2[n],b=S2[n+1];
      if(a.ti&&!a.to&&b.to){a.to=b.to;a.tot=null;a.lunchMiss=b.ti?'lunch OUT punch missing':'lunch OUT and IN punches missing';S2.splice(n+1,1);n--;continue}
      if(a.ti&&a.to&&!b.ti&&b.to){a.to=b.to;a.tot=null;a.lunchMiss='lunch IN punch missing';S2.splice(n+1,1);n--;continue}
    }});
  // 3) roll up per person + day + dept
  const g={};
  Object.values(pd2).forEach(p=>p.segs.forEach(sg=>{
    const{ti,to,code}=sg;let h=sg.tot;
    if((h==null||sg.lunchMiss)&&ti&&to){const a=tmin(ti),b=tmin(to);if(a!=null&&b!=null)h=((b-a+1440)%1440)/60}
    const k=p.d+'|'+p.name.toUpperCase()+'|'+code;
    const x=g[k]=g[k]||{d:p.d,name:p.name,id:p.id,dept:code,tot:0,miss:0,io:[],fin:1e9};const tm=tmin(ti);if(tm!=null)x.fin=Math.min(x.fin,tm);
    if(sg.lunchMiss)x.lunchMiss=sg.lunchMiss;
    x.tot+=(ti&&to)?(h||0):0;if(!ti||!to)x.miss++;if(ti&&!to){const m=tmin(ti);if(m!=null)x.open=(x.open||[]).concat(m)}x.io.push((ti?tshort(ti):'??')+'–'+(to?tshort(to):'??'));
  }));
  const days=[...new Set(Object.values(g).map(x=>x.d))].sort();
  if(!days.length)return null;
  return days.map(dk=>{const dt=new Date(dk+'T00:00:00');
    const rows=Object.values(g).filter(x=>x.d===dk).sort((a,b)=>a.name.localeCompare(b.name)).map((x,n)=>({i:n,src:'punch',name:x.name,emp:x.id,dept:x.dept,raw:+x.tot.toFixed(2),fin:x.fin,reg:+x.tot.toFixed(2),ot:0,dt:0,tot:+x.tot.toFixed(2),pay:0,site:'TT',bucket:bucketOf(x.dept),miss:x.miss,open:x.open||null,lunchMiss:x.lunchMiss||null,io:x.io.join(', ')}));
    return{name:name+(days.length>1?' ('+mdy(dt).slice(0,5)+')':''),start:dt,end:dt,single:true,rows,moves:[],key:dk}});
}
/* California OT (per associate, all punches/depts combined):
   daily: first 8 = REG, 8–12 = OT 1.5×, over 12 = DT 2×
   weekly (Mon–Sun): REG hours past 40 become OT
   7th consecutive day worked in the week: first 8 = OT, over 8 = DT */
let NODED=false,NODEL=false,NOLUNCH=false; // NODEL = price as if nobody was deleted // true = price without handshake deductions (for before/after)
function reprice(){
  const wk={};S.files.forEach(f=>{if(!f.rows.some(r=>r.src==='punch'))return;(wk[iso(weSat(f.end))]=wk[iso(weSat(f.end))]||[]).push(f)});
  Object.values(wk).forEach(fs=>{
    const byDay={};fs.forEach(f=>{if(f.single)byDay[f.start.getDay()]=f});
    const wkReg={},daysWorked={};
    for(const dw of [1,2,3,4,5,6,0]){const f=byDay[dw];if(!f)continue;const fx=f.fix||{},dd=NODED?{}:(f.ded||{});
      const ppl={};f.rows.forEach(r=>{if(r.src!=='punch')return;if(r.raw==null)r.raw=r.tot;if(r.fin==null)r.fin=1e9;
        r.bucket=bucketOf(r.dept);r.site='TT';const x=fx[r.i]||{};r.deleted=!!x.del&&!NODEL;const base=r.deleted?0:Math.max(0,x.hrs!=null&&x.hrs!==''?num(x.hrs)+(NOLUNCH&&x.lunchDed!=null?x.lunchDed/60:0):r.raw),cut=Math.min(base,num(dd[r.i]||0));
        r.base=base;r.hrs=+(base-cut).toFixed(2);r.removed=cut>0&&r.hrs<=.001;r.trimmed=cut>0&&!r.removed?+cut.toFixed(2):0;
        (ppl[nkey(r)]=ppl[nkey(r)]||[]).push(r)});
      Object.entries(ppl).forEach(([k,rs])=>{
        const t=rs.reduce((a,r)=>a+r.hrs,0);
        const worked=(daysWorked[k]||0)+(t>0?1:0);daysWorked[k]=worked;
        let reg,ot,dt;
        if(dw===0&&worked===7&&t>0){reg=0;ot=Math.min(t,8);dt=Math.max(0,t-8)}
        else{reg=Math.min(t,8);ot=Math.min(Math.max(t-8,0),4);dt=Math.max(t-12,0)}
        const c=wkReg[k]||0,keep=Math.min(reg,Math.max(0,40-c)),wkOT=reg-keep;wkReg[k]=c+keep;
        // hand out the day's hours to each dept row in punch order: REG, then OT (weekly, then daily), then DT
        const seq=[['reg',keep],['ot',wkOT+ot],['dt',dt]];let si=0;
        rs.sort((a,b)=>a.fin-b.fin).forEach(r=>{r.reg=0;r.ot=0;r.dt=0;let left=r.hrs;
          while(left>1e-9&&si<seq.length){const take=Math.min(left,seq[si][1]);r[seq[si][0]]+=take;seq[si][1]-=take;left-=take;if(seq[si][1]<=1e-9)si++}
          r.reg=+r.reg.toFixed(2);r.ot=+r.ot.toFixed(2);r.dt=+r.dt.toFixed(2);r.tot=+(r.reg+r.ot+r.dt).toFixed(2);r.wkOT=wkOT>0;
          const x=fx[r.i]||{},pr=x.rate!=null&&x.rate!==''?num(x.rate):RATES[rkey(r)]!=null?num(RATES[rkey(r)]):num(LRATE[r.bucket]),rt=billOf(pr);
          r.payRate=pr;r.rate=rt;r.pay=+(rt*(r.reg+1.5*r.ot+2*r.dt)).toFixed(2)});
      });
    }
  });
}
function ratePanel(){
  const codes=[...new Set(S.files.flatMap(f=>f.rows.map(r=>r.dept)))].sort();
  const hrs={};S.files.forEach(f=>f.rows.forEach(r=>hrs[r.dept]=(hrs[r.dept]||0)+r.tot));
  const un=codes.filter(c=>!DEPTMAP[c]&&!nameLine(c)),odd=codes.filter(c=>!DEPT_DEF[c]&&(DEPTMAP[c]||!nameLine(c)));
  const dflt=BUCKETS.every(b=>num(LRATE[b])===PAY_DEF[b])&&num(MU.pct)===MU_DEF;
  return`<h3>Pay Rates & Markup</h3><div class="mvbox noprint" style="display:block">
   <div class="scroll"><table class="orig rb" style="max-width:640px"><thead><tr><th>Line</th><th>Pay Rate $/hr</th><th>Markup %</th><th>Bill Rate $/hr</th><th>OT Bill (1.5×)</th><th>DT Bill (2×)</th></tr></thead><tbody>
   ${BUCKETS.map((b,n)=>{const br=billOf(LRATE[b]);return`<tr><td><b>${b}</b></td><td><input data-lrate="${b}" value="${esc(LRATE[b]??'')}" inputmode="decimal"></td>${n===0?`<td rowspan="${BUCKETS.length}"><input data-mu value="${esc(MU.pct)}" inputmode="decimal" style="width:70px"></td>`:''}<td><b>$${br.toFixed(2)}</b></td><td>$${(br*1.5).toFixed(2)}</td><td>$${(br*2).toFixed(2)}</td></tr>`}).join('')}
   </tbody></table></div>
   <div style="display:flex;gap:10px;align-items:center;margin-top:8px;flex-wrap:wrap">${dflt?'<span class="tag">STANDARD RATES</span>':`<span class="tag t2">CHANGED FROM STANDARD</span> <button class="mini" data-ratereset>RESET TO 23 / 25 / 20 @ 28.5%</button>`}</div>
   ${odd.length?`<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;align-items:center"><b style="font-size:11px;letter-spacing:.5px;color:var(--mute)">OTHER DEPT → LINE:</b>
   ${odd.map(c=>`<span style="display:flex;gap:4px;align-items:center;font-size:13px"><b>${esc(c)}</b><small style="color:var(--mute)">(${f2(hrs[c]||0)} hrs)</small><select data-dmap="${esc(c)}" style="font:inherit;padding:2px 4px;${DEPTMAP[c]?'':'border:2px solid var(--bad)'}"><option value="">assign…</option>${BUCKETS.map(b=>`<option ${DEPTMAP[c]===b?'selected':''}>${b}</option>`).join('')}</select></span>`).join('')}</div>`:''}
   <div class="hint" style="margin-top:6px">${un.length?`<b class="neg">${un.length} dept code(s) not assigned — counted as GENERAL LABOR.</b> `:''}Rates are saved and apply to every day of every week. Bill rate = pay rate × (1 + markup). <b>California OT:</b> over 8/day = OT 1.5×, over 12/day = DT 2×, regular hrs past 40 in the week = OT, 7th straight day = OT first 8 / DT after.</div></div>`;
}
function rateLine(){return`<div class="hint noprint" style="margin:-4px 0 10px">Bill rates: ${BUCKETS.map(b=>`${b} $${billOf(LRATE[b]).toFixed(2)}`).join(' · ')} (pay + ${esc(MU.pct)}% markup) — change on the <a href="#" data-gosum>SUMMARY</a> tab.</div>`}
function add(p){
  const i=S.files.findIndex(f=>f.key===p.key);
  if(i>=0){S.files[i]=p;alert('Replaced file for '+label(p))}else S.files.push(p);
  S.week=iso(weSat(p.end));
  S.tab=p.single?p.key:p.key;
}
function setDay(f,dIso){
  const dt=new Date(dIso+'T00:00:00');if(isNaN(dt))return alert('Bad date.');
  const nk=iso(dt),old=f.key;if(nk===old&&f.single)return;
  const j=S.files.findIndex(x=>x.key===nk&&x!==f);
  if(j>=0){S.files.splice(j,1);alert('Replaced the file that was on '+mdy(dt))}
  f.start=f.end=dt;f.single=true;f.key=nk;
  if(S.inputs[old]){S.inputs[nk]=S.inputs[old];delete S.inputs[old]}
  S.week=iso(weSat(dt));S.tab=nk;render();
}
const label=f=>f.single?DAYS[f.start.getDay()]+' '+mdy(f.start):mdy(f.start)+' – '+mdy(f.end);

/* ---------- compute ---------- */
/* ---------- timecard issues: missed punch / no bill rate ---------- */
let RATES=(()=>{try{return JSON.parse(localStorage.getItem('tt_rates')||'{}')}catch(e){return{}}})();
const saveRates=()=>{try{localStorage.setItem('tt_rates',JSON.stringify(RATES))}catch(e){}};
const rkey=r=>r.name.toUpperCase()+'|'+r.dept.toUpperCase();
S.pmin=2;S.pmax=12;S.lunchNeed=5;S.lunchMin=30;S.lunchGap=15; // CA: meal by 5 hrs worked, 30 min; a gap of 15+ min between punches counts as a lunch
function origRate(r){const u=r.reg+1.5*r.ot+2*(r.dt||0);return r.pay&&u>0?r.pay/u:0}
function deptRate(dept){ // median straight-time bill rate for this dept across loaded files
  const v=[];S.files.forEach(f=>f.rows.forEach(r=>{if(r.dept===dept&&r.pay>0&&r.tot>0){const x=origRate(r);if(x>0)v.push(x)}}));
  if(!v.length)return 0;v.sort((a,b)=>a-b);return v[Math.floor(v.length/2)];
}
const isNoRate=r=>Math.abs(r.tot)>.001&&Math.abs(r.pay)<.005;
function punchWhy(f,r){
  if(r.deleted)return'';
  r={...r,tot:r.raw!=null?r.raw:r.tot};
  if(r.miss)return r.open?'no OUT punch — still on the clock?':'missing '+(r.io.includes('??–')?'IN':'OUT')+' punch';
  if(r.tot<0||r.reg<0)return'negative hours';
  if(Math.abs(r.tot)<.001)return'zero hours';
  if(f.single&&r.tot<S.pmin)return`under ${S.pmin} hrs`;
  if(f.single&&r.tot>S.pmax)return`over ${S.pmax} hrs`;
  return'';
}
// salaried leads: flat bill $ per day worked, saved by associate name
const SAL={}; // salary feature removed — every associate bills hourly
const saveSal=()=>{};
const nkey=r=>r.name.toUpperCase().replace(/\s+/g,' ').trim();
const isLead=r=>/LEAD/i.test(r.dept)||/\(S?L\)/i.test(r.name);
const salDays=(f,r)=>f.single?1:((f.sdays||{})[r.i]!=null?num(f.sdays[r.i]):Math.max(1,Math.round(Math.abs(r.tot)/8)));
function fixRow(f,r){
  const o=fixRow0(f,r),sal=SAL[nkey(r)],fx=(f.fix||{})[r.i];
  if(sal!=null&&sal!==''&&Math.abs(o.tot)>.001&&!(fx&&fx.rate!=null&&fx.rate!=='')){o.pay=num(sal)*salDays(f,r);o.salary=num(sal);o.sdays=salDays(f,r);o.savedRate=false}
  return o;
}
function fixRow0(f,r){
  if(r.src==='punch'){const fx=(f.fix||{})[r.i]||{};return{...r,fixed:fx.hrs!=null&&fx.hrs!==''||fx.rate!=null&&fx.rate!=='',rateUsed:r.rate||0,savedRate:false}}
  const fx=(f.fix||{})[r.i],sv=RATES[rkey(r)];
  if(!fx&&!(isNoRate(r)&&sv))return{...r};
  const o={...r};
  if(fx&&fx.reg!=null&&fx.reg!=='')o.reg=num(fx.reg);
  if(fx&&fx.ot!=null&&fx.ot!=='')o.ot=num(fx.ot);
  o.tot=o.reg+o.ot;
  const rate=fx&&fx.rate!=null&&fx.rate!==''?num(fx.rate):(isNoRate(r)&&sv?sv:origRate(r));
  if(fx&&(fx.reg!=null||fx.ot!=null||fx.rate!=null)||isNoRate(r))o.pay=rate*(o.reg+1.5*o.ot);
  o.fixed=!!fx&&(fx.reg!=null||fx.ot!=null||fx.rate!=null);o.rateUsed=rate;o.savedRate=!fx&&!!sv;
  return o;
}
/* ---------- LUNCH: read each person's IN/OUT pairs for the day ---------- */
const ioMin=t=>{const m=String(t).match(/(\d{1,2}):(\d{2})\s*([ap])?/i);if(!m)return null;let h=+m[1];if(m[3]){h%=12;if(m[3].toLowerCase()==='p')h+=12}return h*60+(+m[2])};
const mclock=m=>{m=((m%1440)+1440)%1440;let h=Math.floor(m/60),mm=m%60,ap=h<12?'a':'p';h=h%12||12;return h+':'+String(mm).padStart(2,'0')+ap};
function lunchCheck(f){
  const ppl={};
  f.rows.forEach(r=>{if(r.deleted||r.removed||!r.io)return;const k=nkey(r);const p=ppl[k]=ppl[k]||{name:r.name,rows:[],segs:[]};p.rows.push(r);
    r.io.split(',').forEach(x=>{const [a,b]=x.split('–');const i=ioMin(a),o=ioMin(b);if(i!=null)p.segs.push([i,o])})});
  const out=[];
  Object.values(ppl).forEach(p=>{
    if(!p.segs.length)return;
    // overnight: if punches span more than 12 hrs of clock, the early-morning ones belong after midnight
    const ins=p.segs.map(s=>s[0]);if(Math.max(...ins)-Math.min(...ins)>720)p.segs.forEach(s=>{if(s[0]<720){s[0]+=1440;if(s[1]!=null)s[1]+=1440}});
    p.segs.forEach(s=>{if(s[1]!=null&&s[1]<s[0])s[1]+=1440});
    p.segs.sort((a,b)=>a[0]-b[0]);
    const open=p.segs.some(s=>s[1]==null);
    const worked=p.segs.reduce((a,s)=>a+(s[1]!=null?s[1]-s[0]:0),0)/60;
    const gaps=[];for(let n=1;n<p.segs.length;n++){const prev=p.segs[n-1][1];if(prev==null)continue;const g=p.segs[n][0]-prev;if(g>=S.lunchGap)gaps.push({from:prev,to:p.segs[n][0],min:g})}
    let why='',kind='';
    if(gaps.length>=2){kind='double';why=`${gaps.length} lunches: `+gaps.map(g=>`${mclock(g.from)}–${mclock(g.to)} (${g.min} min)`).join(', ')}
    else if(!gaps.length&&!open&&worked>S.lunchNeed){kind='none';const lm=p.rows.find(r=>r.lunchMiss);why=lm?`${lm.lunchMiss} — counted ${f2(worked)} hrs straight through`:`no lunch punch — ${f2(worked)} hrs worked`}
    else if(gaps.length===1&&gaps[0].min<S.lunchMin){kind='short';why=`short lunch ${gaps[0].min} min (${mclock(gaps[0].from)}–${mclock(gaps[0].to)})`}
    else if(gaps.length===1){const before=(gaps[0].from-p.segs[0][0])/60;if(before>S.lunchNeed){kind='late';why=`late lunch — started after ${f2(before)} hrs`}}
    if(!kind)return;
    const main=p.rows.slice().sort((a,b)=>(b.hrs||0)-(a.hrs||0))[0];
    out.push({kind,why,name:p.name,rows:p.rows,main,worked,gaps,io:p.rows.map(r=>r.io).join(', '),fx:(f.fix||{})[main.i]||{}});
  });
  const ord={none:0,double:1,short:2,late:3};
  return out.sort((a,b)=>ord[a.kind]-ord[b.kind]||a.name.localeCompare(b.name));
}
function issues(f){
  const rows=f.rows.filter(r=>S.sites.has(r.site)&&!r.deleted&&!r.removed),fx=f.fix||{};
  const punch=rows.filter(r=>punchWhy(f,r)).map(r=>({r,why:punchWhy(f,r),fx:fx[r.i]||{}}));
  const norate=rows.filter(r=>isNoRate(r)).map(r=>({r,fx:fx[r.i]||{}}));
  const done=x=>x.fx.ok||(x.fx.hrs!=null&&x.fx.hrs!=='')||(x.fx.reg!=null&&x.fx.reg!=='')||(x.fx.ot!=null&&x.fx.ot!=='');
  const rdone=x=>x.fx.ok||(x.r.pay>0)||(x.fx.rate!=null&&x.fx.rate!=='')||!!RATES[rkey(x.r)];
  const lunch=lunchCheck(f),ldone=x=>!!x.fx.lunchOk||x.fx.lunchDed!=null;
  return{leads:[],lunch,ldone,openL:lunch.filter(x=>!ldone(x)).length,punch,norate,openP:punch.filter(x=>!done(x)).length,openR:norate.filter(x=>!rdone(x)).length,done,rdone};
}
function issuePanel(f){
  const I=issues(f);if(!I.punch.length&&!I.norate.length&&!I.lunch.length)return`<h3>Timecard Issues</h3><div class="plan" style="border-color:var(--good)">✓ No missed punches, lunch issues or missing bill rates.</div>`;
  const k=f.key,cur=fixRow;
  const inp3=(i,fl,v,ph)=>`<input data-fix="${i}" data-fl="${fl}" data-f="${k}" value="${v==null?'':esc(v)}" placeholder="${esc(ph)}" inputmode="decimal">`;
  let h=`<h3>Timecard Issues</h3><div class="issues">`;
  // missed punch
  h+=`<div class="ibox ${I.openP?'open':''}"><div class="ihd"><b>MISSED PUNCH</b> <span class="cnt">${I.openP} open / ${I.punch.length}</span>
    ${f.single?`<span class="thr">flag under <input data-thr="pmin" value="${S.pmin}"> or over <input data-thr="pmax" value="${S.pmax}"> hrs</span>`:'<span class="thr">period file — flags zero/negative only</span>'}</div>`;
  const openRows=f.rows.filter(r=>r.open&&r.open.length&&!r.deleted);
  if(openRows.length){const waiting=openRows.filter(r=>{const x=(f.fix||{})[r.i]||{};return x.hrs==null||x.hrs===''}).length;
    h+=`<div class="mvbox" style="display:flex;margin:8px 0"><b style="font-size:12px">${openRows.length} still clocked in (no OUT)${waiting<openRows.length?` · ${openRows.length-waiting} filled`:''}</b>
      <label>SET OUT TIME FOR ALL<input type="time" id="openOut_${k}" value="${esc(S.openOut||'18:30')}" style="min-width:0;width:130px"></label>
      <label>MEAL BREAK (MIN)<input id="openMeal_${k}" value="${esc(S.openMeal??'30')}" inputmode="numeric" style="min-width:0;width:80px"></label>
      <button class="pri" data-act="openfill" data-f="${k}">FILL ${waiting||openRows.length} OPEN PUNCH${(waiting||openRows.length)>1?'ES':''}</button>
      ${waiting<openRows.length?`<button data-act="openclr" data-f="${k}">CLEAR FILLED</button>`:''}
      <span class="hint" style="flex-basis:100%">Hours = OUT time − IN punch − meal break, for everyone with no OUT. Re-drop the punch report later to use real OUT punches.</span></div>`}
  if(I.punch.length){h+=`<div class="scroll"><table class="itbl"><thead><tr><th>Employee</th><th>Dept</th><th>Why</th><th>Punch Hrs</th><th>Correct Hrs</th><th>Reg / OT / DT</th><th>Rate</th><th>Bill $</th><th></th></tr></thead><tbody>`;
    I.punch.forEach(x=>{const r=x.r,o=cur(f,r),ok=I.done(x);
      h+=`<tr class="${ok?'okrow':''}"><td>${esc(r.name)}${r.io?`<br><small style="color:var(--mute)">${esc(r.io)}</small>`:''}</td><td>${esc(r.dept)}</td><td class="neg">${x.why}</td>
      <td>${f2(r.raw!=null?r.raw:r.tot)}</td><td>${inp3(r.i,'hrs',x.fx.hrs,'hrs')}</td><td>${f2(r.reg)} / ${hr(r.ot)} / ${hr(r.dt||0)}</td><td>${o.rateUsed||origRate(r)?'$'+(o.rateUsed||origRate(r)).toFixed(2):'–'}</td><td>${$m(o.pay)}</td>
      <td>${ok?`<span class="tag">${x.fx.ok?'OK':'FIXED'}</span> <button class="mini x" data-act="fixclr" data-f="${k}" data-i="${r.i}">reset</button>`:`<button class="mini" data-act="fixok" data-f="${k}" data-i="${r.i}">OK as is</button>`}</td></tr>`});
    h+=`</tbody></table></div>`}else h+=`<div class="pos" style="font-size:13px">✓ None</div>`;
  h+=`</div>`;
  // lunch
  const KL={none:'NO LUNCH',double:'DOUBLE LUNCH',short:'SHORT LUNCH',late:'LATE LUNCH'};
  const cntK=t=>I.lunch.filter(x=>x.kind===t).length;
  h+=`<div class="ibox ${I.openL?'open':''}"><div class="ihd"><b>LUNCH</b> <span class="cnt">${I.openL} open / ${I.lunch.length}</span>
    ${['none','double','short','late'].filter(t=>cntK(t)).map(t=>`<span class="tag ${t==='none'||t==='double'?'rm':'t2'}">${cntK(t)} ${KL[t].toLowerCase()}</span>`).join(' ')}
    <span class="thr">lunch needed over <input data-thr="lunchNeed" value="${S.lunchNeed}"> hrs · under <input data-thr="lunchMin" value="${S.lunchMin}"> min is short</span>
    ${I.lunch.some(x=>x.kind==='none'&&!I.ldone(x))?`<button class="mini" data-act="lunchdedall" data-f="${k}">DEDUCT 30 MIN FROM ALL NO-LUNCH</button>`:''}</div>`;
  if(I.lunch.length){h+=`<div class="scroll"><table class="itbl"><thead><tr><th>Employee</th><th>Dept</th><th>Issue</th><th>Punches</th><th>Hrs Worked</th><th></th></tr></thead><tbody>`;
    I.lunch.forEach(x=>{const ok=I.ldone(x),r=x.main;
      h+=`<tr class="${ok?'okrow':''}"><td>${esc(x.name)}</td><td>${[...new Set(x.rows.map(z=>z.dept))].map(esc).join(', ')}</td>
       <td><span class="tag ${x.kind==='none'||x.kind==='double'?'rm':'t2'}">${KL[x.kind]}</span> <small>${esc(x.why)}</small></td>
       <td style="text-align:left;font-size:11px;color:var(--mute)">${esc(x.io)}</td><td>${f2(x.worked)}</td>
       <td style="white-space:nowrap">${x.fx.lunchDed!=null?`<span class="tag">−${x.fx.lunchDed} min deducted</span> <button class="mini x" data-act="lunchundo" data-f="${k}" data-i="${r.i}">undo</button>`:
         x.fx.lunchOk?`<span class="tag">OK</span> <button class="mini x" data-act="lunchundo" data-f="${k}" data-i="${r.i}">undo</button>`:
         `${x.kind==='none'?`<button class="mini" data-act="lunchded" data-f="${k}" data-i="${r.i}">DEDUCT 30 MIN</button> `:''}<button class="mini" data-act="lunchok" data-f="${k}" data-i="${r.i}">OK AS IS</button>`}</td></tr>`});
    h+=`</tbody></table></div><div class="hint" style="margin-top:4px">A gap of ${S.lunchGap}+ min between an OUT and the next IN counts as a lunch. Double lunch: both gaps are already unpaid, so hours are correct — check it wasn't a missed IN/OUT. DEDUCT 30 MIN takes 30 min off and recalculates OT.</div>`}
  else h+=`<div class="pos" style="font-size:13px">✓ None</div>`;
  h+=`</div>`;
  // no bill rate
  h+=`<div class="ibox ${I.openR?'open':''}"><div class="ihd"><b>NO BILL RATE</b> <span class="cnt">${I.openR} open / ${I.norate.length}</span>
    ${I.openR?`<button class="mini" data-act="fillrate" data-f="${k}">FILL OPEN WITH DEPT AVG</button>`:''}</div>`;
  if(I.norate.length){h+=`<div class="scroll"><table class="itbl"><thead><tr><th>Employee</th><th>Dept</th><th>Reg</th><th>OT</th><th>DT</th><th>Pay Rate</th><th>Bill $</th><th></th></tr></thead><tbody>`;
    I.norate.forEach(x=>{const r=x.r,o=cur(f,r),ok=I.rdone(x),dr=deptRate(r.dept),sv=RATES[rkey(r)];
      h+=`<tr class="${ok?'okrow':''}"><td>${esc(r.name)}</td><td>${esc(r.dept)}</td><td>${f2(r.reg)}</td><td>${hr(r.ot)}</td><td>${hr(r.dt||0)}</td>
      <td>${inp3(r.i,'rate',x.fx.rate!=null?x.fx.rate:(sv!=null?sv:null),dr?'dept avg '+dr.toFixed(2):'$/hr')}</td><td>${$m(o.pay)}</td>
      <td>${ok?`<span class="tag">${x.fx.ok?'OK':sv&&x.fx.rate==null?'SAVED RATE':'FIXED'}</span> <button class="mini x" data-act="fixclr" data-f="${k}" data-i="${r.i}">reset</button>`:`<button class="mini" data-act="fixok" data-f="${k}" data-i="${r.i}">OK as is</button>`}</td></tr>`});
    h+=`</tbody></table></div><div class="hint" style="margin-top:4px">Pay rates you enter are saved for that associate + dept; markup is added on top.</div>`}else h+=`<div class="pos" style="font-size:13px">✓ None</div>`;
  h+=`</div>`;
  return h+`</div>`;
}
function editRow(f,i){
  const r=f.rows.find(x=>x.i===i);if(!r)return;const fx=(f.fix||{})[i]||{};
  const dlg=document.getElementById('dlg');
  dlg.innerHTML=`<div class="card"><h3 style="margin-top:0">EDIT — ${esc(r.name)}</h3><p style="margin:0 0 8px;color:var(--mute)">${esc(r.dept)} · punches ${esc(r.io||'')} · ${f2(r.raw!=null?r.raw:r.tot)} hrs<br>now ${f2(r.reg)} reg / ${f2(r.ot)} OT / ${f2(r.dt||0)} DT · ${$m(r.pay)}</p>
    <label>TOTAL HOURS WORKED (Reg / OT / DT recalculated)<input id="xHrs" inputmode="decimal" value="${fx.hrs!=null?esc(fx.hrs):+(r.raw!=null?r.raw:r.tot).toFixed(2)}"></label>
    <label>PAY RATE $/HR (markup ${esc(MU.pct)}% added → bill)<input id="xRate" inputmode="decimal" value="${(r.payRate||0).toFixed(2)}"></label>
    <div style="display:flex;gap:8px;justify-content:space-between;margin-top:12px"><button id="xReset" class="mini x">RESET TO PUNCHES</button><span><button id="xCancel">CANCEL</button> <button class="pri" id="xGo">SAVE</button></span></div></div>`;
  dlg.style.display='flex';const close=()=>{dlg.style.display='none'};
  document.getElementById('xCancel').onclick=close;dlg.onclick=e=>{if(e.target===dlg)close()};
  document.getElementById('xReset').onclick=()=>{if(f.fix)delete f.fix[i];close();render()};
  document.getElementById('xGo').onclick=()=>{
    f.fix=f.fix||{};const n={};const h=document.getElementById('xHrs').value.trim(),rt=document.getElementById('xRate').value.trim();
    if(h!==''&&Math.abs(num(h)-(r.raw!=null?r.raw:r.tot))>.004)n.hrs=h;
    const lr=num(LRATE[r.bucket]);if(rt!==''&&Math.abs(num(rt)-(RATES[rkey(r)]!=null?num(RATES[rkey(r)]):lr))>.004){n.rate=rt;RATES[rkey(r)]=num(rt);saveRates()}
    if(Object.keys(n).length)f.fix[i]=n;else delete f.fix[i];
    close();render();
  };
}
function applyMoves(f){
  return f.rows.map(r=>fixRow(f,r));
  const rows=f.rows.map(r=>fixRow(f,r));
  (f.moves||[]).forEach(m=>{
    if(m.kind==='emp'){
      const r=rows.find(x=>x.i===m.i&&!x.moved);if(!r||r.tot<=0)return;
      const h=Math.min(m.hrs,r.tot),fr=h/r.tot;
      const mv={...r,i:null,moved:m.id,from:r.dept,dept:m.to,site:siteOf(m.to),bucket:bucketOf(m.to),reg:r.reg*fr,ot:r.ot*fr,tot:h,pay:r.pay*fr};
      r.reg-=mv.reg;r.ot-=mv.ot;r.tot-=h;r.pay-=mv.pay;r.touched=true;
      rows.push(mv);
    }else if(m.kind==='add'){
      const r=rows.find(x=>x.i===m.i&&!x.moved);if(!r)return;
      const u=r.reg+1.5*r.ot;let rate=u>0&&r.pay?r.pay/u:deptRate(r.dept);
      r.reg+=m.hrs;r.tot+=m.hrs;r.pay+=r.salary!=null?0:m.hrs*rate;r.added=(r.added||0)+m.hrs;
      rows.rm=rows.rm||{};rows.rm[m.id]={hrs:-m.hrs,pay:r.salary!=null?0:-m.hrs*rate};
    }else if(m.kind==='rm'){
      const r=rows.find(x=>x.i===m.i&&!x.moved);if(!r||r.tot<=0)return;
      const h=Math.min(m.hrs,r.tot),fr=h/r.tot,pay=r.pay*fr;
      r.reg-=r.reg*fr;r.ot-=r.ot*fr;r.tot-=h;r.pay-=pay;
      if(r.tot<=.001){r.tot=0;r.reg=0;r.ot=0;r.pay=0;r.removed=true}else r.trimmed=(r.trimmed||0)+h;
      rows.rm=rows.rm||{};rows.rm[m.id]={hrs:h,pay};
    }else{
      const base={i:null,adj:m.id,ot:0,name:'⇄ DEPT ADJUSTMENT'};
      rows.push({...base,dept:m.from,site:siteOf(m.from),bucket:bucketOf(m.from),reg:-m.hrs,tot:-m.hrs,pay:-m.hrs*m.rate,from:m.from,to:m.to});
      rows.push({...base,dept:m.to,site:siteOf(m.to),bucket:bucketOf(m.to),reg:m.hrs,tot:m.hrs,pay:m.hrs*m.rate,from:m.from,to:m.to});
    }
  });
  return rows;
}
function rowsFor(f){return applyMoves(f).filter(r=>S.sites.has(r.site))}
function rawFor(f){return f.rows.filter(r=>S.sites.has(r.site))}
function moveDesc(f,m){
  if(m.kind==='emp'){const r=f.rows.find(x=>x.i===m.i);return`${m.auto?'[AUTO] ':''}${r?r.name:'?'}: ${m.from} → ${m.to}`}
  if(m.kind==='add'){const r=f.rows.find(x=>x.i===m.i);return`${m.auto?'[AUTO] ':''}${r?r.name:'?'}: hours added (${m.from})`}
  if(m.kind==='rm'){const r=f.rows.find(x=>x.i===m.i);return`${m.auto?'[AUTO] ':''}${r?r.name:'?'}: ${m.whole?'removed from report':'hours trimmed'} (${m.from})`}
  return`${m.from} → ${m.to} (dept move @ ${$m(m.rate)}/hr)`;
}
function moveAmt(ar,m){
  if(m.kind==='emp'){const r=ar.find(x=>x.moved===m.id)||{tot:0,pay:0};return{hrs:r.tot,pay:r.pay}}
  if(m.kind==='rm'||m.kind==='add'){const x=(ar.rm||{})[m.id]||{hrs:0,pay:0};return{hrs:-x.hrs,pay:-x.pay}}
  return{hrs:m.hrs,pay:m.hrs*m.rate};
}
function addMove(f,m){f.moves.push({id:Date.now()+Math.random(),...m});render()}
const siteLbl=()=>{const a=[...S.sites].sort();return a.length?a.join(', '):'none'};
function agg(rows){
  const o={};BUCKETS.forEach(b=>o[b]={reg:0,ot:0,dt:0,tot:0,pay:0,names:new Set()});
  const all=new Set();
  rows.forEach(r=>{const a=o[r.bucket];a.reg+=r.reg;a.ot+=r.ot;a.dt+=(r.dt||0);a.tot+=r.tot;a.pay+=r.pay;if((r.tot>0||(r.miss&&r.open&&!r.deleted&&!r.removed))&&!r.adj){a.names.add(r.name);all.add(r.name)}});
  const t={reg:0,ot:0,dt:0,tot:0,pay:0};BUCKETS.forEach(b=>{t.reg+=o[b].reg;t.ot+=o[b].ot;t.dt+=o[b].dt;t.tot+=o[b].tot;t.pay+=o[b].pay});
  t.head=all.size;return{b:o,t};
}
const inp=(k,b)=>{S.inputs[k]=S.inputs[k]||{};return S.inputs[k][b]=S.inputs[k][b]||{hs:'',hc:'',vol:'',inv:''}};
function weekFiles(){
  const sat=new Date(S.week+'T00:00:00'),sun=new Date(sat);sun.setDate(sat.getDate()-6); // sat = week-ending Sunday, sun = Monday start
  const days=DAYS.map((_,i)=>{const d=new Date(sun);d.setDate(sun.getDate()+i);return{d,f:S.files.find(f=>f.single&&f.key===iso(d))}});
  const ranges=S.files.filter(f=>!f.single&&iso(weSat(f.end))===S.week);
  return{sat,sun,days,ranges};
}

/* ---------- render ---------- */
function render(){
  drop.classList.toggle('small',S.files.length>0);
  // site options
  const sites=new Map();S.files.forEach(f=>f.rows.forEach(r=>sites.set(r.site,(sites.get(r.site)||0)+1)));
  const sorted=[...sites.keys()].sort();
  // first time a site code shows up: auto-select 06 if present, else the first site
  const fresh=sorted.filter(x=>!S.seen.has(x));fresh.forEach(x=>S.seen.add(x));
  [...S.sites].forEach(x=>{if(!sites.has(x))S.sites.delete(x)});
  if(sites.size&&!S.sites.size&&fresh.length===S.seen.size)S.sites.add(sites.has('TT')?'TT':sorted[0]);
  const hrs={};S.files.forEach(f=>f.rows.forEach(r=>hrs[r.site]=(hrs[r.site]||0)+r.tot));
  const sb=document.getElementById('sitebar');
  sb.style.display=sites.size?'flex':'none';
  sb.innerHTML='<b>SITE FILTER</b><span class="sc all" data-s="*ALL">ALL</span><span class="sc all" data-s="*NONE">NONE</span>'+
    sorted.map(x=>`<span class="sc ${S.sites.has(x)?'on':''}" data-s="${x}">${x}${SITE_NAMES[x]?' · '+SITE_NAMES[x]:''}<small>${f2(hrs[x]||0)} hrs</small></span>`).join('');
  const un=[...new Set(S.files.flatMap(f=>f.rows.filter(r=>r.site==='??').map(r=>r.dept)))];
  if(un.length)sb.innerHTML+=`<div class="unas">No site code: ${un.map(d=>`<span><b>${esc(d)}</b> → <select data-alias="${esc(d)}"><option value="">assign site…</option>${sorted.filter(x=>x!=='??').map(x=>`<option>${x}</option>`).join('')}</select></span>`).join(' ')}</div>`;
  const mapped=Object.keys(ALIAS).filter(k=>ALIAS[k]&&S.files.some(f=>f.rows.some(r=>r.dept.toUpperCase()===k)));
  if(mapped.length)sb.innerHTML+=`<div class="unas" style="background:#eef6f1;border-color:#bfe3cf">Assigned: ${mapped.map(k=>`${esc(k)} → <b>${ALIAS[k]}</b> <a href="#" data-unalias="${esc(k)}">change</a>`).join(' · ')}</div>`;
  sb.querySelectorAll('select[data-alias]').forEach(el=>el.onchange=()=>{if(!el.value)return;ALIAS[el.dataset.alias.toUpperCase()]=el.value;saveAlias();resite();render()});
  sb.querySelectorAll('[data-unalias]').forEach(el=>el.onclick=e=>{e.preventDefault();delete ALIAS[el.dataset.unalias];if(DEF_ALIAS[el.dataset.unalias])ALIAS[el.dataset.unalias]='';saveAlias();resite();render()});
  sb.querySelectorAll('.sc').forEach(el=>el.onclick=()=>{
    const v=el.dataset.s;
    if(v==='*ALL')sorted.forEach(x=>S.sites.add(x));else if(v==='*NONE')S.sites.clear();
    else S.sites.has(v)?S.sites.delete(v):S.sites.add(v);
    if(!S.sites.size&&v!=='*NONE')S.sites.add(sorted[0]);
    const one=[...S.sites];document.getElementById('siteName').value=one.length===1?(SITE_NAMES[one[0]]||'SITE '+one[0]):'MULTI-SITE ('+one.sort().join(', ')+')';
    render()});
  // weeks
  const weeks=[...new Set(S.files.map(f=>iso(weSat(f.end))))].sort();
  const ws=document.getElementById('week');
  if(!weeks.includes(S.week))S.week=weeks[weeks.length-1]||null;
  ws.innerHTML=weeks.map(w=>`<option value="${w}">${mdy(new Date(w+'T00:00:00'))}</option>`).join('')||'<option>—</option>';
  if(S.week)ws.value=S.week;
  // chips
  document.getElementById('files').innerHTML=S.files.map((f,i)=>`<span class="chip">${esc(label(f))} · ${f.rows.length} rows <a href="#" data-cd="${i}" title="Change the date this file counts for">change date</a><x data-i="${i}" title="Remove">×</x></span>`).join('');
  document.querySelectorAll('[data-cd]').forEach(a=>a.onclick=e=>{e.preventDefault();const f=S.files[+a.dataset.cd];ask('Date this file is for — '+f.name,'SET DATE',v=>setDay(f,v),iso(f.start))});
  document.querySelectorAll('.chip x').forEach(x=>x.onclick=()=>{const f=S.files[+x.dataset.i];ask('Remove '+label(f)+' and its saved work?','REMOVE',()=>{const k=S.files.indexOf(f);if(k>=0)S.files.splice(k,1);delete S.inputs[f.key];render()})});
  const v=document.getElementById('view');
  if(!S.files.length){v.innerHTML='';return}
  const W=weekFiles();
  const tabs=W.days.map(({d,f})=>({k:iso(d),t:DAYS[d.getDay()].toUpperCase(),s:mdy(d).slice(0,5),has:!!f}))
    .concat(W.ranges.map(f=>({k:f.key,t:'PERIOD',s:mdy(f.start).slice(0,5)+'–'+mdy(f.end).slice(0,5),has:true})))
    .concat([{k:'SUMMARY',t:'SUMMARY',s:'W.E. '+mdy(W.sat).slice(0,5),has:true},{k:'LOST',t:'LOST HRS',s:'report',has:true}]);
  if(!tabs.some(t=>t.k===S.tab))S.tab=(tabs.find(t=>t.has&&t.k!=='SUMMARY'&&t.k!=='LOST')||tabs[tabs.length-1]).k;
  const badge=k=>{const f=S.files.find(x=>x.key===k);if(!f)return'';const I=issues(f),n=I.openP+I.openR+I.openL;return n?`<span class="bdg">${n}</span>`:''};
  let h='<div class="tabs">'+tabs.map(t=>`<div class="tab ${t.has?'has':''} ${S.tab===t.k?'on':''}" data-k="${t.k}">${t.t}${badge(t.k)}<small>${t.s}</small></div>`).join('')+'</div><div class="panel">';
  if(S.tab==='SUMMARY')h+=summaryView(W);
  else if(S.tab==='LOST')h+=lostView(W);
  else{const f=S.files.find(x=>x.key===S.tab);h+=f?dayView(f):emptyDay(S.tab)}
  v.innerHTML=h+'</div>';
  {const b=document.getElementById('btnLostX');if(b)b.onclick=exportLost;document.querySelectorAll('[data-xdel]').forEach(x=>x.onclick=exportRemoved)}
  v.querySelectorAll('[data-lrate]').forEach(el=>el.onchange=()=>{const v2=el.value.replace(/[$,\s]/g,'');if(v2==='')delete LRATE[el.dataset.lrate];else LRATE[el.dataset.lrate]=num(v2);LSs('tt_payrates',LRATE);render()});
  v.querySelectorAll('[data-mu]').forEach(el=>el.onchange=()=>{MU.pct=num(el.value.replace('%',''));LSs('tt_markup',MU);render()});
  v.querySelectorAll('[data-ratereset]').forEach(el=>el.onclick=()=>{Object.keys(LRATE).forEach(k=>delete LRATE[k]);Object.assign(LRATE,PAY_DEF);MU.pct=MU_DEF;LSs('tt_payrates',LRATE);LSs('tt_markup',MU);render()});
  v.querySelectorAll('[data-gosum]').forEach(el=>el.onclick=e=>{e.preventDefault();S.tab='SUMMARY';render()});
  v.querySelectorAll('[data-dmap]').forEach(el=>el.onchange=()=>{if(el.value)DEPTMAP[el.dataset.dmap]=el.value;else delete DEPTMAP[el.dataset.dmap];LSs('tt_deptmap',DEPTMAP);render()});
  v.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>{S.week=iso(weSat(new Date(b.dataset.go+'T00:00:00')));S.tab=b.dataset.go;render()});
  v.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{S.tab=t.dataset.k;render()});
  v.querySelectorAll('input[data-k]').forEach(el=>el.oninput=()=>{inp(el.dataset.k,el.dataset.b)[el.dataset.f]=el.value;recalc()});
  v.querySelectorAll('[data-flt]').forEach(el=>{const run=()=>{S.flt=el.value;const q=el.value.toLowerCase();el.closest('.in').querySelectorAll('tr[data-q]').forEach(tr=>tr.style.display=tr.dataset.q.includes(q)?'':'none')};el.oninput=run;run()});
  v.querySelectorAll('details[data-emp]').forEach(d=>d.ontoggle=()=>{S.openEmp=d.open?d.dataset.emp:null});
  v.querySelectorAll('[data-act]').forEach(el=>el.onclick=()=>act(el.dataset));
  v.querySelectorAll('input[data-fix]').forEach(el=>el.onchange=()=>{const f=S.files.find(x=>x.key===el.dataset.f);if(!f)return;f.fix=f.fix||{};const i=+el.dataset.fix,fl=el.dataset.fl;
    const fx=f.fix[i]=f.fix[i]||{};if(el.value.trim()===''){delete fx[fl]}else fx[fl]=el.value.trim();delete fx.ok;
    const r=f.rows.find(x=>x.i===i);if(fl==='rate'&&r){if(el.value.trim()===''){delete RATES[rkey(r)]}else RATES[rkey(r)]=num(el.value);saveRates()}
    if(!Object.keys(fx).length)delete f.fix[i];render()});
  v.querySelectorAll('input[data-thr]').forEach(el=>el.onchange=()=>{S[el.dataset.thr]=num(el.value)||S[el.dataset.thr];render()});
  v.querySelectorAll('textarea[data-k]').forEach(el=>el.oninput=()=>{S.inputs[el.dataset.k]=S.inputs[el.dataset.k]||{};S.inputs[el.dataset.k]._notes=el.value});
}
function emptyDay(k){
  const d=new Date(k+'T00:00:00');
  const loaded=S.files.filter(f=>f.single).sort((a,b)=>a.start-b.start);
  return`<p style="color:var(--mute)">No punch report for <b>${DAYS[d.getDay()]} ${mdy(d)}</b> yet — drop that day's Punch Report above and it lands here by its date automatically.</p>`+
    (loaded.length?`<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center"><b style="font-size:11px;letter-spacing:.5px;color:var(--mute)">LOADED DAYS:</b>${loaded.map(f=>`<span class="sc" data-go="${f.key}">${DAYS[f.start.getDay()]} ${mdy(f.start).slice(0,5)}<small>${f.rows.length} rows</small></span>`).join('')}</div>`:'');
}
function siteTitle(){return document.getElementById('siteName').value||siteLbl()}

function repHead(dateStr){return`<div class="rhead"><div class="rlogo"><img src="data:image/png;base64,${LOGO_B64}" alt="Lyneer"></div><div class="rlab">SITE:</div><div class="rsite">${esc(siteTitle())}</div><div class="rlab">DATE:</div><div class="rdate">${esc(dateStr)}</div></div>`}
function sumTable(k,A,opts={}){
  let h=`<div class="scroll"><table class="orig"><thead><tr><th>Department</th><th>Active Count</th><th>Handshake HC</th><th>Reg Hours</th><th>OT Hours</th><th>DT Hours</th><th>Total Hours</th><th>Total Billing</th><th>Handshake Hrs</th><th>Volume</th><th>PPH</th><th>CPP</th>${opts.inv?'<th>Invoice $</th><th>Diff</th>':''}</tr></thead><tbody>`;
  BUCKETS.forEach(b=>{
    const a=A.b[b];
    const I=opts.ro?opts.ro[b]:inp(k,b);
    const vol=num(I.vol),pph=vol&&a.tot?vol/a.tot:0,cpp=vol?a.pay/vol:0;
    const cnt=opts.cnt?opts.cnt[b]:a.names.size;
    const field=(fl,val)=>opts.ro?(val?(fl==='hc'?num(val):f2(num(val))):'–'):`<input data-k="${k}" data-b="${b}" data-f="${fl}" value="${esc(val)}" inputmode="decimal">`;
    h+=`<tr class="${a.tot||a.pay?'':'zero'}" data-b="${b}"><td><b>${b}</b></td><td>${cnt||'–'}</td><td>${field('hc',I.hc)}</td><td>${hr(a.reg)}</td><td class="${a.ot?'ot':''}">${hr(a.ot)}</td><td class="${a.dt?'neg':''}">${hr(a.dt)}</td><td><b>${hr(a.tot)}</b></td><td>${a.pay?$m(a.pay):'–'}</td>
      <td>${field('hs',I.hs)}</td><td>${field('vol',I.vol)}</td><td class="pph">${pph?f2(pph):'–'}</td><td class="cpp">${cpp?'$'+cpp.toFixed(3):'–'}</td>
      ${opts.inv?`<td><input data-k="${k}" data-b="${b}" data-f="inv" value="${esc(inp(k,b).inv)}" inputmode="decimal"></td><td class="diff">${diffCell(a.pay,inp(k,b).inv)}</td>`:''}</tr>`;
  });
  const T=A.t;const tv=opts.ro?BUCKETS.reduce((s,b)=>s+num(opts.ro[b].vol),0):BUCKETS.reduce((s,b)=>s+num(inp(k,b).vol),0);
  const ths=opts.ro?BUCKETS.reduce((s,b)=>s+num(opts.ro[b].hs),0):BUCKETS.reduce((s,b)=>s+num(inp(k,b).hs),0);
  const thc=opts.ro?BUCKETS.reduce((s,b)=>s+num(opts.ro[b].hc),0):BUCKETS.reduce((s,b)=>s+num(inp(k,b).hc),0);
  const ti=opts.inv?BUCKETS.reduce((s,b)=>s+num(inp(k,b).inv),0):0;
  h+=`<tr class="tot"><td>TOTALS</td><td>${opts.cnt?opts.cnt._t:T.head}</td><td>${thc||'–'}</td><td>${hr(T.reg)}</td><td>${hr(T.ot)}</td><td>${hr(T.dt)}</td><td>${hr(T.tot)}</td><td>${$m(T.pay)}</td><td class="ths">${ths?f2(ths):'–'}</td><td class="tv">${tv?f2(tv):'–'}</td><td class="tpph">${tv&&T.tot?f2(tv/T.tot):'–'}</td><td class="tcpp">${tv?'$'+(T.pay/tv).toFixed(3):'–'}</td>${opts.inv?`<td class="ti">${ti?$m(ti):'–'}</td><td class="tdiff">${(()=>{const bs=BUCKETS.filter(b=>inp(k,b).inv!=='');if(!bs.length)return'–';const d=bs.reduce((s2,b)=>s2+A.b[b].pay-num(inp(k,b).inv),0);return`<span class="${Math.abs(d)<.01?'pos':'neg'}">${$m(d)}</span>`})()}</td>`:''}</tr></tbody></table></div>`;
  return h;
}
function diffCell(pay,inv){if(inv===''||inv==null)return'–';const d=pay-num(inv);return`<span class="${Math.abs(d)<.01?'pos':'neg'}">${$m(d)}</span>`}
function recalc(){ // light refresh of computed cells without losing focus
  const a=document.activeElement,id=a&&a.dataset?{k:a.dataset.k,b:a.dataset.b,f:a.dataset.f,src:a.dataset.src,pos:a.selectionStart}:null;
  render();
  if(id&&id.k){const el=document.querySelector(`input[data-k="${id.k}"][data-b="${id.b}"][data-f="${id.f}"]${id.src?`[data-src="${id.src}"]`:':not([data-src])'}`);if(el){el.focus();try{el.setSelectionRange(id.pos,id.pos)}catch(e){}}}
}
function kpis(T,extra=''){
  return`<div class="kpis"><div class="kpi"><div class="l">Headcount</div><div class="v">${T.head}</div></div><div class="kpi"><div class="l">Reg Hours</div><div class="v">${f2(T.reg)}</div></div><div class="kpi"><div class="l">OT Hours (1.5×)</div><div class="v ${T.ot?'ot':''}">${f2(T.ot)}</div></div><div class="kpi"><div class="l">DT Hours (2×)</div><div class="v ${T.dt?'neg':''}">${f2(T.dt)}</div></div><div class="kpi"><div class="l">Total Hours</div><div class="v">${f2(T.tot)}</div></div><div class="kpi"><div class="l">Total Billing</div><div class="v">${$m(T.pay)}</div></div>${extra}</div>`;
}
/* ---------- LOST HOURS: everything taken off billing for the week ---------- */
function lostHours(W){
  const files=W.days.map(x=>x.f).filter(Boolean).concat(W.ranges);
  const snap=()=>{const m={};files.forEach(f=>f.rows.forEach(r=>{m[f.key+'|'+r.i]={tot:r.tot,reg:r.reg,ot:r.ot,dt:r.dt||0,pay:r.pay,removed:r.removed,deleted:r.deleted,trimmed:r.trimmed}}));return m};
  reprice();const now=snap();
  NODED=NODEL=NOLUNCH=true;reprice();const full=snap();NODED=NODEL=NOLUNCH=false;reprice();
  const L=[];
  files.forEach(f=>f.rows.forEach(r=>{const k=f.key+'|'+r.i,a=full[k],b=now[k];if(!a||!b)return;
    const dh=a.tot-b.tot,dp=a.pay-b.pay;if(dh<.001&&Math.abs(dp)<.005)return;
    const x=(f.fix||{})[r.i]||{},why=[];
    if(b.deleted)why.push('Deleted');
    else{if(b.removed)why.push('Handshake HC — removed');if(b.trimmed)why.push('Handshake hrs — trimmed');if(x.lunchDed!=null&&dh>.001)why.push('No lunch — '+x.lunchDed+' min deducted')}
    if(!why.length)why.push('OT moved (hours removed earlier in week)');
    L.push({f,d:f.start,name:r.name,dept:r.dept,line:r.bucket,why:why.join(' + '),kind:why[0],punch:a.tot,billed:b.tot,hrs:dh,pay:dp,reg:a.reg-b.reg,ot:a.ot-b.ot,dt:a.dt-b.dt})}));
  // removed / deleted people: no names — one line per day + line + reason
  const anon=x=>x.kind==='Deleted'||x.kind==='Handshake HC — removed';
  const grp={};L.filter(anon).forEach(x=>{const k=iso(x.d)+'|'+x.line+'|'+x.kind;const g=grp[k]=grp[k]||{...x,n:new Set(),punch:0,billed:0,hrs:0,pay:0,reg:0,ot:0,dt:0,depts:new Set()};
    g.n.add(x.name);g.depts.add(x.dept);['punch','billed','hrs','pay','reg','ot','dt'].forEach(q=>g[q]+=x[q])});
  const kept=L.filter(x=>!anon(x));L.length=0;kept.forEach(x=>L.push(x));
  Object.values(grp).forEach(g=>L.push({...g,name:g.n.size+' associate'+(g.n.size>1?'s':''),dept:[...g.depts].join(', '),anon:true,cnt:g.n.size,nset:g.n}));
  L.sort((p,q)=>p.d-q.d||LOST_ORDER.indexOf(p.kind)-LOST_ORDER.indexOf(q.kind)||p.name.localeCompare(q.name));
  const by=key=>{const o={};L.forEach(x=>{const g=o[x[key]]=o[x[key]]||{n:new Set(),hrs:0,pay:0};(x.nset?[...x.nset]:[x.name]).forEach(n=>g.n.add(n));g.hrs+=x.hrs;g.pay+=x.pay});return o};
  return{L,hrs:L.reduce((a,x)=>a+x.hrs,0),pay:L.reduce((a,x)=>a+x.pay,0),people:new Set(L.filter(x=>x.hrs>.001).flatMap(x=>x.nset?[...x.nset]:[x.name])).size,byKind:by('kind'),byLine:by('line')};
}
const LOST_ORDER=['Handshake HC — removed','Handshake hrs — trimmed','Deleted','No lunch — 30 min deducted','OT moved (hours removed earlier in week)'];
function lostView(W){
  const X=lostHours(W);
  let h=`<div class="ttl"><h2>${esc(siteTitle())} — LOST HOURS REPORT</h2><span class="m">W.E. ${mdy(W.sat)} · ${mdy(W.sun)} – ${mdy(W.sat)}</span></div>`;
  h+=`<div class="kpis"><div class="kpi"><div class="l">People</div><div class="v">${X.people}</div></div><div class="kpi"><div class="l">Hours Lost</div><div class="v neg">${f2(X.hrs)}</div></div><div class="kpi"><div class="l">Billing Lost</div><div class="v neg">${$m(X.pay)}</div></div></div>`;
  h+=`<div class="noprint" style="margin:8px 0;display:flex;gap:8px;flex-wrap:wrap"><button class="pri" id="btnLostX">EXPORT LOST HOURS TO EXCEL</button><button data-xdel="1">📋 EXPORT DELETED ASSOCIATES LIST</button></div>`;
  if(!X.L.length)return h+`<div class="plan" style="border-color:var(--good)">✓ No hours taken off this week.</div>`;
  const kinds=Object.keys(X.byKind).sort((a,b)=>LOST_ORDER.indexOf(a)-LOST_ORDER.indexOf(b));
  h+=`<div style="display:flex;gap:16px;flex-wrap:wrap"><div style="min-width:0;flex:1 1 340px"><h3>By Reason</h3><div class="scroll"><table class="orig"><thead><tr><th>Reason</th><th>People</th><th>Hrs Lost</th><th>Billing Lost</th></tr></thead><tbody>
    ${kinds.map(k=>{const g=X.byKind[k];return`<tr><td style="text-align:left"><b>${esc(k)}</b></td><td>${g.n.size}</td><td>${f2(g.hrs)}</td><td class="neg">${$m(g.pay)}</td></tr>`}).join('')}
    <tr class="tot"><td>TOTAL</td><td>${X.people}</td><td>${f2(X.hrs)}</td><td>${$m(X.pay)}</td></tr></tbody></table></div></div>
   <div style="min-width:0;flex:1 1 300px"><h3>By Line</h3><div class="scroll"><table class="orig"><thead><tr><th>Line</th><th>People</th><th>Hrs Lost</th><th>Billing Lost</th></tr></thead><tbody>
    ${BUCKETS.filter(b=>X.byLine[b]).map(b=>{const g=X.byLine[b];return`<tr><td><b>${b}</b></td><td>${g.n.size}</td><td>${f2(g.hrs)}</td><td class="neg">${$m(g.pay)}</td></tr>`}).join('')}
    <tr class="tot"><td>TOTAL</td><td>${X.people}</td><td>${f2(X.hrs)}</td><td>${$m(X.pay)}</td></tr></tbody></table></div></div></div>`;
  h+=`<h3>Detail</h3><div class="scroll"><table class="orig"><thead><tr><th>Date</th><th>Employee</th><th>Dept</th><th>Line</th><th>Reason</th><th>Punch Hrs</th><th>Billed Hrs</th><th>Hrs Lost</th><th>Billing Lost</th></tr></thead><tbody>
    ${X.L.map(x=>`<tr><td>${DAYS[x.d.getDay()]} ${mdy(x.d).slice(0,5)}</td><td style="text-align:left">${x.anon?`<i>${esc(x.name)}</i>`:esc(x.name)}</td><td>${esc(x.dept)}</td><td>${x.line}</td><td style="text-align:left">${esc(x.why)}</td><td>${f2(x.punch)}</td><td>${f2(x.billed)}</td><td class="neg">${x.hrs>.001?f2(x.hrs):'–'}</td><td class="neg">${$m(x.pay)}</td></tr>`).join('')}
    <tr class="tot"><td colspan="5">TOTAL</td><td></td><td></td><td>${f2(X.hrs)}</td><td>${$m(X.pay)}</td></tr></tbody></table></div>`;
  return h;
}
function removedList(W){ // the ONLY place names of deleted / removed associates appear
  const files=W.days.map(x=>x.f).filter(Boolean).concat(W.ranges);
  reprice();const now={};files.forEach(f=>f.rows.forEach(r=>{now[f.key+'|'+r.i]={deleted:r.deleted,removed:r.removed}}));
  NODED=NODEL=true;reprice();
  const L=[];files.forEach(f=>f.rows.forEach(r=>{const n=now[f.key+'|'+r.i];if(!n||!(n.deleted||n.removed))return;const x=(f.fix||{})[r.i]||{};
    L.push({d:f.start,name:r.name,emp:r.emp||'',dept:r.dept,line:r.bucket,why:n.deleted?'Deleted':'Handshake HC — removed',io:r.io||'',reg:r.reg,ot:r.ot,dt:r.dt||0,hrs:r.tot,pay:r.pay,when:x.delAt?new Date(x.delAt):null})}));
  NODED=NODEL=false;reprice();
  return L.sort((a,b)=>a.d-b.d||a.why.localeCompare(b.why)||a.name.localeCompare(b.name));
}
async function exportRemoved(){
  if(typeof ExcelJS==='undefined')return alert('Excel library did not load — check your internet connection and reload.');
  const W=weekFiles(),L=removedList(W),t=siteTitle(),wb=new ExcelJS.Workbook();
  if(!L.length)return alert('No deleted or removed associates this week.');
  const ws=wb.addWorksheet('DELETED ASSOCIATES',{views:[{showGridLines:false}],properties:{tabColor:{argb:'FFC0392B'}},pageSetup:{orientation:'landscape',fitToPage:true,fitToWidth:1,fitToHeight:0}});
  xHeader(wb,ws,t,'W.E. '+mdy(W.sat));
  [11,26,10,9,15,22,24,8,8,8,9,12].forEach((w2,i)=>ws.getColumn(i+1).width=w2);
  const G='FFE7E6E6',Y='FFFFF2CC',C='ABCDEFGHIJKL';
  let row=7;ws.mergeCells(`A${row}:L${row}`);xSet(ws,'A'+row,'DELETED / REMOVED ASSOCIATES — '+mdy(W.sun)+' to '+mdy(W.sat),{h:'left',color:'FFFFFFFF',fill:'FFC0392B',sz:13});row+=2;
  const top=row;['DATE','EMPLOYEE','EMP #','DEPT','LINE','REASON','PUNCHES','REG','OT','DT','HRS','BILLING'].forEach((h2,i)=>xSet(ws,C[i]+row,h2,{fill:G}));row++;
  const r1=row;
  L.forEach(x=>{[DAYS[x.d.getDay()]+' '+mdy(x.d).slice(0,5),x.name,x.emp,x.dept,x.line,x.why,x.io,+x.reg.toFixed(2),+x.ot.toFixed(2),+x.dt.toFixed(2),+x.hrs.toFixed(2),+x.pay.toFixed(2)]
    .forEach((v,i)=>xSet(ws,C[i]+row,v,{b:false,h:i===1||i===5||i===6?'left':'center',fmt:i===11?XC.$:i>=7?XC.h:undefined}));row++});
  ws.mergeCells(`A${row}:G${row}`);xSet(ws,'A'+row,`TOTAL — ${new Set(L.map(x=>x.name)).size} associates`,{fill:Y});
  ['H','I','J','K','L'].forEach((c,i)=>xSet(ws,c+row,F(`SUM(${c}${r1}:${c}${row-1})`,+L.reduce((a,x)=>a+[x.reg,x.ot,x.dt,x.hrs,x.pay][i],0).toFixed(2)),{fmt:i===4?XC.$:XC.h,fill:Y}));
  xBox(ws,top,1,row,12);
  const buf=await wb.xlsx.writeBuffer();
  const code=(t.replace(/^MULTI-SITE.*/,'MULTI')||siteLbl()).replace(/[^\w]/g,'');
  await saveFile(`${code}_DELETED_ASSOCIATES_W.E._${mdy(W.sat)}.xlsx`,new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}));
}
async function exportLost(){
  if(typeof ExcelJS==='undefined')return alert('Excel library did not load — check your internet connection and reload.');
  const W=weekFiles(),X=lostHours(W),t=siteTitle(),wb=new ExcelJS.Workbook();
  const ws=wb.addWorksheet('LOST HOURS',{views:[{showGridLines:false}],properties:{tabColor:{argb:'FFC0392B'}},pageSetup:{orientation:'landscape',fitToPage:true,fitToWidth:1,fitToHeight:0}});
  xHeader(wb,ws,t,'W.E. '+mdy(W.sat));
  [11,26,9,15,34,11,11,11,13,13].forEach((w,i)=>ws.getColumn(i+1).width=w);
  const G='FFE7E6E6',Y='FFFFF2CC';
  let row=7;ws.mergeCells(`A${row}:I${row}`);xSet(ws,'A'+row,'LOST HOURS REPORT — '+mdy(W.sun)+' to '+mdy(W.sat),{h:'left',color:'FFFFFFFF',fill:'FFC0392B',sz:13});row+=2;
  // by reason
  const kinds=Object.keys(X.byKind).sort((a,b)=>LOST_ORDER.indexOf(a)-LOST_ORDER.indexOf(b));
  const top=row;['REASON','PEOPLE','HRS LOST','BILLING LOST'].forEach((h2,i)=>xSet(ws,['A','C','D','E'][i]+row,h2,{fill:G}));ws.mergeCells(`A${row}:B${row}`);row++;
  const k1=row;kinds.forEach(k=>{const g=X.byKind[k];ws.mergeCells(`A${row}:B${row}`);xSet(ws,'A'+row,k,{h:'left',b:false});xSet(ws,'C'+row,g.n.size,{b:false});xSet(ws,'D'+row,+g.hrs.toFixed(2),{fmt:XC.h,b:false});xSet(ws,'E'+row,+g.pay.toFixed(2),{fmt:XC.$,b:false});row++});
  ws.mergeCells(`A${row}:B${row}`);xSet(ws,'A'+row,'TOTAL',{fill:Y});xSet(ws,'C'+row,X.people,{fill:Y});
  xSet(ws,'D'+row,F(`SUM(D${k1}:D${row-1})`,+X.hrs.toFixed(2)),{fmt:XC.h,fill:Y});xSet(ws,'E'+row,F(`SUM(E${k1}:E${row-1})`,+X.pay.toFixed(2)),{fmt:XC.$,fill:Y});
  xBox(ws,top,1,row,5);row+=2;
  // by line
  const top2=row;['LINE','PEOPLE','HRS LOST','BILLING LOST'].forEach((h2,i)=>xSet(ws,['A','C','D','E'][i]+row,h2,{fill:G}));ws.mergeCells(`A${row}:B${row}`);row++;
  const l1=row;BUCKETS.filter(b=>X.byLine[b]).forEach(b=>{const g=X.byLine[b];ws.mergeCells(`A${row}:B${row}`);xSet(ws,'A'+row,b,{h:'left',b:false});xSet(ws,'C'+row,g.n.size,{b:false});xSet(ws,'D'+row,+g.hrs.toFixed(2),{fmt:XC.h,b:false});xSet(ws,'E'+row,+g.pay.toFixed(2),{fmt:XC.$,b:false});row++});
  ws.mergeCells(`A${row}:B${row}`);xSet(ws,'A'+row,'TOTAL',{fill:Y});xSet(ws,'C'+row,X.people,{fill:Y});
  xSet(ws,'D'+row,F(`SUM(D${l1}:D${row-1})`,+X.hrs.toFixed(2)),{fmt:XC.h,fill:Y});xSet(ws,'E'+row,F(`SUM(E${l1}:E${row-1})`,+X.pay.toFixed(2)),{fmt:XC.$,fill:Y});
  xBox(ws,top2,1,row,5);row+=2;
  // detail
  const top3=row;['DATE','EMPLOYEE','DEPT','LINE','REASON','PUNCH HRS','BILLED HRS','HRS LOST','BILLING LOST'].forEach((h2,i)=>xSet(ws,'ABCDEFGHI'[i]+row,h2,{fill:G}));row++;
  const d1=row;
  X.L.forEach(x=>{const v=[DAYS[x.d.getDay()]+' '+mdy(x.d).slice(0,5),x.name,x.dept,x.line,x.why,+x.punch.toFixed(2),+x.billed.toFixed(2),+x.hrs.toFixed(2),+x.pay.toFixed(2)];
    v.forEach((val,i)=>xSet(ws,'ABCDEFGHI'[i]+row,val,{b:false,h:i===1||i===4?'left':'center',fmt:i===8?XC.$:i>=5?XC.h:undefined}));row++});
  if(!X.L.length){ws.mergeCells(`A${row}:I${row}`);xSet(ws,'A'+row,'No hours taken off this week.',{b:false});row++}
  ws.mergeCells(`A${row}:G${row}`);xSet(ws,'A'+row,'TOTAL',{fill:Y});
  xSet(ws,'H'+row,F(`SUM(H${d1}:H${row-1})`,+X.hrs.toFixed(2)),{fmt:XC.h,fill:Y});xSet(ws,'I'+row,F(`SUM(I${d1}:I${row-1})`,+X.pay.toFixed(2)),{fmt:XC.$,fill:Y});
  xBox(ws,top3,1,row,9);
  const buf=await wb.xlsx.writeBuffer();
  const code=(t.replace(/^MULTI-SITE.*/,'MULTI')||siteLbl()).replace(/[^\w]/g,'');
  await saveFile(`${code}_LOST_HOURS_W.E._${mdy(W.sat)}.xlsx`,new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}));
}
/* ---------- HANDSHAKE: Active Count vs Handshake HC, Report Hrs vs Handshake Hrs → deduct ---------- */
function priced(fn){NODED=true;reprice();const a=fn();NODED=false;reprice();return a}
const hsv=(k,b,fl)=>{const v=((S.inputs[k]||{})[b]||{})[fl];return v===''||v==null?null:num(v)};
function bestRemoveSet(c,n,E){ // n people whose hours add up closest to E without going over (else fewest hours)
  if(n<=0)return[];if(c.length<=n)return c.slice();
  const X=E==null?0:Math.max(0,Math.round(E*4));
  if(E!=null&&X<=6000&&c.length*n*X<=3e7){
    const w=c.map(r=>Math.max(0,Math.round(r.left*4)));
    const dp=Array.from({length:n+1},()=>new Array(X+1).fill(null));dp[0][0]=[];
    c.forEach((r,ci)=>{for(let k=Math.min(n,ci+1);k>=1;k--)for(let v=X;v>=w[ci];v--){const q=dp[k-1][v-w[ci]];if(q&&!dp[k][v])dp[k][v]=q.concat(ci)}});
    for(let v=X;v>=0;v--)if(dp[n][v])return dp[n][v].map(ci=>c[ci]);
  }
  return c.slice().sort((a,b)=>a.left-b.left).slice(0,n);
}
function hsDeduct(f){
  const k=f.key,ded={},res={removed:0,removedH:0,trimN:0,trimH:0,left:[]};
  priced(()=>{
    const day={};f.rows.forEach(r=>{if(r.base>0)day[nkey(r)]=(day[nkey(r)]||0)+r.base}); // person's whole day (OT people are removed/trimmed last)
    BUCKETS.forEach(b=>{
      const t=hsv(k,b,'hs'),c=hsv(k,b,'hc');if(t==null&&c==null)return;
      const ppl={};f.rows.filter(r=>r.bucket===b&&r.base>.001).forEach(r=>{const p=ppl[nkey(r)]=ppl[nkey(r)]||{name:r.name,rows:[],left:0,t:day[nkey(r)]>8?1:0};p.rows.push({r,left:r.base});p.left+=r.base});
      const P=Object.values(ppl);let E=t==null?null:P.reduce((a,p)=>a+p.left,0)-t;
      // 1) headcount over → take whole people off (the ones whose hours best cover the hours over)
      const n=c==null?0:Math.max(0,P.length-c);
      if(n){let cand=P.filter(p=>p.t===0);if(cand.length<n)cand=P.slice();
        const set=bestRemoveSet(cand,n,E!=null&&E>0?E:null);
        set.forEach(p=>{p.rows.forEach(x=>{ded[x.r.i]=(ded[x.r.i]||0)+x.left;x.left=0});res.removed++;res.removedH+=p.left;if(E!=null)E-=p.left;p.left=0});
        if(set.length<n)res.left.push(`${b}: only ${set.length} of ${n} people could be removed`);}
      // 2) hours still over → trim in 15-min steps, spread across the line (non-OT people first)
      if(E!=null&&E>.001){let u=Math.round(E*4),g=0;const trimmed=new Set();
        for(const maxT of [0,1]){const grp=P.filter(p=>p.t<=maxT&&p.left>.26).sort((a,b)=>b.left-a.left);
          while(u>0&&grp.some(p=>p.left>.26)&&g++<100000)for(const p of grp){if(u<=0)break;if(p.left<=.26)continue;
            const x=p.rows.filter(y=>y.left>.26).sort((a,b)=>b.left-a.left)[0];if(!x)continue;
            x.left-=.25;p.left-=.25;ded[x.r.i]=(ded[x.r.i]||0)+.25;u--;res.trimH+=.25;trimmed.add(p.name)}
          if(u<=0)break}
        res.trimN=res.trimN+trimmed.size;
        if(u>0)res.left.push(`${b}: still ${f2(u/4)} hrs over handshake`);}
      if(E!=null&&E<-.001)res.left.push(`${b}: ${f2(-E)} hrs UNDER handshake — nothing deducted`);
      if(c!=null&&P.length<c)res.left.push(`${b}: active count ${P.length} is under handshake HC ${c}`);
    });
  });
  f.ded=ded;f.dedRes=res;render();
}
function delImpact(files){ // what deleted people would have billed (each person's OT stands alone)
  NODEL=true;reprice();
  const out=files.map(f=>{const L=f?f.rows.filter(r=>((f.fix||{})[r.i]||{}).del).map(r=>({i:r.i,name:r.name,bucket:r.bucket,hrs:r.tot,reg:r.reg,ot:r.ot,dt:r.dt||0,pay:r.pay})):[];
    return{list:L,hrs:L.reduce((a,x)=>a+x.hrs,0),pay:L.reduce((a,x)=>a+x.pay,0),n:new Set(L.map(x=>x.name)).size}});
  NODEL=false;reprice();return out;
}
function delPanel(f){
  const D=delImpact([f])[0];if(!D.list.length)return'';
  const by={};D.list.forEach(x=>{const g=by[x.bucket]=by[x.bucket]||{n:new Set(),hrs:0,pay:0};g.n.add(x.name);g.hrs+=x.hrs;g.pay+=x.pay});
  return`<h3>Deleted</h3><div class="mvbox" style="display:block;border-color:#f3b4b0">
   <div style="display:flex;gap:18px;flex-wrap:wrap;align-items:baseline"><b class="neg">${D.n} ${D.n===1?'person':'people'} deleted</b><span><b class="neg">−${f2(D.hrs)}</b> hrs</span><span><b class="neg">−${$m(D.pay)}</b> billing</span>
    <span class="noprint" style="margin-left:auto;display:flex;gap:6px;flex-wrap:wrap"><button class="mini" data-xdel="1">📋 EXPORT DELETED LIST</button><button class="mini" data-act="undellast" data-f="${f.key}">UNDO LAST DELETE</button><button class="mini x" data-act="undelall" data-f="${f.key}">UNDO ALL DELETES</button></span></div>
   <div class="scroll" style="margin-top:6px"><table class="itbl"><thead><tr><th>Line</th><th>People</th><th>Hrs</th><th>Billing</th></tr></thead><tbody>
   ${BUCKETS.filter(b=>by[b]).map(b=>`<tr><td style="text-align:left"><b>${b}</b></td><td>${by[b].n.size}</td><td>${f2(by[b].hrs)}</td><td class="neg">−${$m(by[b].pay)}</td></tr>`).join('')}
   <tr class="tot"><td>TOTAL DELETED</td><td>${D.n}</td><td>${f2(D.hrs)}</td><td class="neg">−${$m(D.pay)}</td></tr></tbody></table></div>
   <div class="hint">Deleted people are left off every report and export.</div></div>`;
}
function hsPanel(f){
  const k=f.key;
  const A0=priced(()=>agg(rowsFor(f))),A1=agg(rowsFor(f));
  const has=b=>hsv(k,b,'hs')!=null||hsv(k,b,'hc')!=null,any=BUCKETS.some(has),applied=Object.keys(f.ded||{}).length>0;
  const dc=(d,on,fmt)=>`<td class="${d>.001?'pos':d<-.001?'neg':''}">${on?(d>0?'+':'')+fmt(d):'–'}</td>`;
  const field=(b,fl)=>`<input data-k="${k}" data-b="${b}" data-f="${fl}" data-src="rb" value="${esc(((S.inputs[k]||{})[b]||{})[fl]||'')}" inputmode="decimal" placeholder="—">`;
  let h=`<h3>Handshake — Headcount &amp; Hours</h3><div class="mvbox noprint" style="display:block">
   <div class="scroll"><table class="orig rb"><thead><tr><th>Line</th><th>Active Count</th><th>Handshake HC</th><th>HC Over / Under</th><th>Punch Hrs</th><th>Handshake Hrs</th><th>Hrs Over / Under</th><th>Report HC</th><th>Report Hrs</th><th>Billing Deducted</th></tr></thead><tbody>`;
  const T={c0:0,hc:0,h0:0,hs:0,c1:0,h1:0,d:0};
  BUCKETS.forEach(b=>{const a0=A0.b[b],a1=A1.b[b],c=hsv(k,b,'hc'),t=hsv(k,b,'hs'),c0=a0.names.size,c1=a1.names.size,dp=a0.pay-a1.pay;
    T.c0+=c0;T.h0+=a0.tot;T.c1+=c1;T.h1+=a1.tot;T.d+=dp;if(c!=null)T.hc+=c;if(t!=null)T.hs+=t;
    h+=`<tr class="${a0.tot||c!=null||t!=null?'':'zero'}"><td><b>${b}</b></td><td>${c0||'–'}</td><td>${field(b,'hc')}</td>${dc(c==null?0:c0-c,c!=null,x=>String(x))}
     <td>${hr(a0.tot)}</td><td>${field(b,'hs')}</td>${dc(t==null?0:a0.tot-t,t!=null,f2)}
     <td><b>${c1||'–'}</b>${c1!==c0?` <span class="tag rm">${c1-c0}</span>`:''}</td><td><b>${hr(a1.tot)}</b>${Math.abs(a1.tot-a0.tot)>.001?` <span class="tag rm">${f2(a1.tot-a0.tot)}</span>`:''}</td>
     <td class="${dp>.005?'neg':''}">${dp>.005?'−'+$m(dp):'–'}</td></tr>`});
  h+=`<tr class="tot"><td>TOTAL</td><td>${A0.t.head}</td><td>${T.hc||'–'}</td><td></td><td>${f2(T.h0)}</td><td>${T.hs?f2(T.hs):'–'}</td><td></td><td>${A1.t.head}</td><td>${f2(T.h1)}</td><td>${T.d>.005?'−'+$m(T.d):'–'}</td></tr></tbody></table></div>
   <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;align-items:center">
    <button class="pri" data-act="hsded" data-f="${k}" ${any?'':'disabled'}>DEDUCT TO MATCH HANDSHAKE</button>
    ${applied?`<button data-act="hsundo" data-f="${k}">UNDO DEDUCTIONS</button>`:''}
    <span class="hint">Over on headcount: whole people come off (the ones whose hours best cover the hours over). Still over on hours: trimmed in 15-min steps across the line. People with OT that day come off last. OT / DT and billing are recalculated after.</span></div>`;
  if(applied&&f.dedRes){const x=f.dedRes,parts=[];
    if(x.removed)parts.push(`removed ${x.removed} associate${x.removed>1?'s':''} (${f2(x.removedH)} hrs)`);
    if(x.trimH)parts.push(`trimmed ${f2(x.trimH)} hrs across ${x.trimN} associate${x.trimN>1?'s':''}`);
    const list=f.rows.filter(r=>(f.ded||{})[r.i]>0&&!r.removed).sort((a,b)=>a.bucket.localeCompare(b.bucket)||a.name.localeCompare(b.name));
    h+=`<div class="plan"><b>${parts.length?parts.join(' · '):'Nothing to deduct.'}</b> · billing −${$m(T.d)}${x.left.length?`<div class="warn" style="margin:6px 0 0">${x.left.map(esc).join('<br>')}</div>`:''}
     ${list.length?`<details style="margin-top:6px"><summary>Who was trimmed (${list.length})</summary><div class="in"><table><thead><tr><th>Employee</th><th>Line</th><th>Punch Hrs</th><th>Deducted</th><th>Billed Hrs</th></tr></thead><tbody>${list.map(r=>`<tr><td>${esc(r.name)}</td><td style="text-align:left">${r.bucket}</td><td>${f2(r.base)}</td><td class="neg">−${f2(f.ded[r.i])}${r.removed?' <span class="tag rm">removed</span>':''}</td><td>${f2(r.hrs)}</td></tr>`).join('')}</tbody></table></div></details>`:''}</div>`}
  else if(applied)h+=`<div class="plan"><b>Deductions applied.</b> · billing −${$m(T.d)}</div>`;
  return h+'</div>';
}
function dayView(f){
  const rows=rowsFor(f),A=agg(rows);
  let h=`<div class="ttl"><h2>${esc(siteTitle())} — ${f.single?DAYS[f.start.getDay()].toUpperCase()+' '+mdy(f.start):'PERIOD '+mdy(f.start)+' – '+mdy(f.end)}</h2><span class="m">${esc(f.name)}</span></div>`;
  h+=kpis(A.t,`<div class="kpi"><div class="l">Avg $/Hr</div><div class="v">${A.t.tot?$m(A.t.pay/A.t.tot):'–'}</div></div>`);
  h+=rateLine();
  if(!rows.length)h+=`<div class="warn">No rows for site(s) ${esc(siteLbl())} in this file. Pick a site in the Site Filter above.</div>`;
  const neg=rows.filter(r=>r.tot<0||r.reg<0);
  if(neg.length)h+=`<div class="warn"><b>${neg.length} negative-hour correction row(s)</b> included in totals: ${neg.slice(0,8).map(r=>esc(r.name)+' ('+esc(r.dept)+' '+f2(r.tot)+')').join(', ')}${neg.length>8?'…':''}</div>`;
  h+=`<div class="sheet">`+repHead(f.single?mdy(f.start):mdy(f.start)+' – '+mdy(f.end))+sumTable(f.key,A)+`</div>`;
  h+=hsPanel(f);
  h+=delPanel(f);
  h+=issuePanel(f);
  h+=`<h3>Notes</h3><textarea data-k="${f.key}" placeholder="Notes for this day…">${esc((S.inputs[f.key]||{})._notes||'')}</textarea>`;
  h+=deptDetail(rows,rawFor(f))+empDetail(rows,f);
  return h;
}
function deptDetail(rows,raw){
  const m={};rows.forEach(r=>{const x=m[r.dept]=m[r.dept]||{b:r.bucket,n:new Set(),reg:0,ot:0,dt:0,tot:0,pay:0,o:0};if(!r.adj&&r.tot>0)x.n.add(r.name);x.reg+=r.reg;x.ot+=r.ot;x.dt+=(r.dt||0);x.tot+=r.tot;x.pay+=r.pay});
  const showD=!!raw;if(raw)raw.forEach(r=>{const x=m[r.dept]=m[r.dept]||{b:r.bucket,n:new Set(),reg:0,ot:0,dt:0,tot:0,pay:0,o:0};x.o+=r.tot});
  const moved=showD&&Object.values(m).some(x=>Math.abs(x.tot-x.o)>.001);
  const ks=Object.keys(m).sort();
  return`<details ${moved?'open':''}><summary>Department breakdown (${ks.length})${moved?' — showing moved hours':''}</summary><div class="in"><table><thead><tr><th>Department</th><th>Bucket</th><th>Count</th><th>Reg</th><th>OT</th><th>DT</th>${moved?'<th>Timecard Hrs</th><th>Moved</th>':''}<th>Total</th><th>Billing</th></tr></thead><tbody>${ks.map(k=>{const x=m[k],d=x.tot-x.o;return`<tr><td>${esc(k)}</td><td style="text-align:left">${x.b}</td><td>${x.n.size}</td><td>${hr(x.reg)}</td><td class="${x.ot?'ot':''}">${hr(x.ot)}</td><td>${hr(x.dt)}</td>${moved?`<td>${hr(x.o)}</td><td class="${d>.001?'pos':d<-.001?'neg':''}">${Math.abs(d)>.001?(d>0?'+':'')+f2(d):'–'}</td>`:''}<td><b>${hr(x.tot)}</b></td><td>${$m(x.pay)}</td></tr>`}).join('')}</tbody></table></div></details>`;
}
function empDetail(rows,f){
  const s=rows.filter(r=>!r.adj&&!r.deleted&&!r.removed).sort((a,b)=>a.dept.localeCompare(b.dept)||a.name.localeCompare(b.name));
  return`<details ${f&&S.openEmp===f.key?'open':''} data-emp="${f?f.key:''}"><summary>Timecard detail (${s.length} rows) — ✎ edit hours / rate · 🗑 delete a person</summary><div class="in"><input class="flt" placeholder="Filter name / dept…" data-flt value="${esc(S.flt||'')}"><table><thead><tr><th>Employee</th><th>Department</th><th>Punches</th><th>Reg</th><th>OT</th><th>DT</th><th>Total</th><th>Total Pay</th>${f?'<th class="noprint">Edit</th>':''}</tr></thead><tbody>${s.map(r=>`<tr class="${r.moved?'mv':''}" data-q="${esc((r.name+' '+r.dept).toLowerCase())}"><td>${esc(r.name)}</td><td style="text-align:left">${esc(r.dept)}${r.moved?` <span class="tag">from ${esc(r.from)}</span>`:''}${r.touched?' <span class="tag t2">partly moved</span>':''}${r.removed?' <span class="tag rm">removed — handshake</span>':''}${r.trimmed?` <span class="tag rm">−${f2(r.trimmed)} hrs handshake</span>`:''}${r.fixed?' <span class="tag">corrected</span>':''}${r.salary!=null?` <span class="tag">salary $${f2(r.salary)}/day</span>`:''}${r.savedRate?' <span class="tag">saved rate</span>':''}${r.i!=null&&!r.moved&&isNoRate(f.rows.find(x=>x.i===r.i)||r)&&!r.pay?' <span class="tag rm">no bill rate</span>':''}${r.deleted?' <span class="tag rm">deleted</span>':''}${r.added?` <span class="tag">+${f2(r.added)} hrs</span>`:''}</td><td style="text-align:left;font-size:11px;color:var(--mute)">${esc(r.io||'')}</td><td class="${r.reg<0?'neg':''}">${hr(r.reg)}</td><td class="${r.ot?'ot':''}">${hr(r.ot)}${r.wkOT?' <span class="tag t2">40+</span>':''}</td><td class="${r.dt?'neg':''}">${hr(r.dt||0)}</td><td class="${r.tot<0?'neg':''}">${hr(r.tot)}</td><td>${$m(r.pay)}</td>${f?`<td class="noprint">${r.i!=null&&!r.moved?(r.deleted?`<button class="mini" data-act="undel" data-f="${f.key}" data-i="${r.i}" title="Put this person back">RESTORE</button>`:`<button class="mini" data-act="edit" data-f="${f.key}" data-i="${r.i}" title="Edit hours / rate">✎</button> <button class="mini x" data-act="del" data-f="${f.key}" data-i="${r.i}" title="Delete this person from this day">🗑</button>`):''}</td>`:''}</tr>`).join('')}</tbody></table></div></details>`;
}
function deptOptions(f){
  const all=new Set();S.files.forEach(x=>x.rows.forEach(r=>{if(S.sites.has(r.site))all.add(r.dept)}));
  return`<datalist id="dl_${f.key}">${[...all].sort().map(d=>`<option value="${esc(d)}">`).join('')}</datalist>`;
}
function beforeRows(f){return f.rows.map(r=>fixRow(f,r)).filter(r=>S.sites.has(r.site))}
function act(d){
  const f=S.files.find(x=>x.key===d.f);if(!f)return;
  if(d.act==='hsded')return hsDeduct(f);
  if(d.act==='openfill'){const t=document.getElementById('openOut_'+f.key).value,ml=num(document.getElementById('openMeal_'+f.key).value);S.openOut=t;S.openMeal=String(ml);
    const m=t.match(/^(\d{1,2}):(\d{2})$/);if(!m)return alert('Pick an OUT time first.');const out=(+m[1])*60+(+m[2]);let n=0;f.fix=f.fix||{};
    f.rows.forEach(r=>{if(!r.open||!r.open.length||r.deleted)return;const x=f.fix[r.i]||{};if(x.hrs!=null&&x.hrs!==''&&!x.openFill)return;
      const add=r.open.reduce((a,inn)=>a+((out-inn+1440)%1440)/60,0);const hrs=Math.max(0,+(r.raw+add-(add>6?ml/60:0)).toFixed(2));
      f.fix[r.i]={...x,hrs:String(hrs),openFill:t};n++});
    alert(`Filled ${n} open punch${n===1?'':'es'} with OUT ${t}${ml?` less ${ml} min meal (shifts over 6 hrs)`:''}.`);return render()}
  if(d.act==='openclr'){Object.keys(f.fix||{}).forEach(i=>{const x=f.fix[i];if(x&&x.openFill){delete x.hrs;delete x.openFill;if(!Object.keys(x).length)delete f.fix[i]}});return render()}
  if(d.act==='hsundo'){f.ded={};f.dedRes=null;return render()}
  if(d.act==='lunchok'||d.act==='lunchded'||d.act==='lunchundo'||d.act==='lunchdedall'){f.fix=f.fix||{};
    const ded=r=>{const x={...(f.fix[r.i]||{})};if(x.lunchDed!=null)return;const base=x.hrs!=null&&x.hrs!==''?num(x.hrs):r.raw;x.hrs=String(Math.max(0,+(base-.5).toFixed(2)));x.lunchDed=30;f.fix[r.i]=x};
    if(d.act==='lunchdedall'){const I=issues(f);I.lunch.filter(x=>x.kind==='none'&&!I.ldone(x)).forEach(x=>ded(x.main));return render()}
    const r=f.rows.find(x=>x.i===+d.i);if(!r)return;const x={...(f.fix[r.i]||{})};
    if(d.act==='lunchok')x.lunchOk=true;
    if(d.act==='lunchded'){f.fix[r.i]=x;ded(r);return render()}
    if(d.act==='lunchundo'){if(x.lunchDed!=null){const base=num(x.hrs)+x.lunchDed/60;delete x.lunchDed;if(Math.abs(base-r.raw)<.005)delete x.hrs;else x.hrs=String(+base.toFixed(2))}delete x.lunchOk}
    if(Object.keys(x).length)f.fix[r.i]=x;else delete f.fix[r.i];return render()}
  if(d.act==='fixok'){f.fix=f.fix||{};f.fix[+d.i]={...(f.fix[+d.i]||{}),ok:true};return render()}
  if(d.act==='fixclr'){const r=f.rows.find(x=>x.i===+d.i);if(f.fix)delete f.fix[+d.i];if(r&&isNoRate(r)&&RATES[rkey(r)]){delete RATES[rkey(r)];saveRates()}return render()}
  if(d.act==='fillrate'){const I=issues(f);f.fix=f.fix||{};let n=0;I.norate.filter(x=>!I.rdone(x)).forEach(x=>{const dr=deptRate(x.r.dept);if(dr){f.fix[x.r.i]={...(f.fix[x.r.i]||{}),rate:dr.toFixed(2)};n++}});if(!n)alert('No dept average available for these departments — enter rates by hand.');return render()}
  if(d.act==='edit')return editRow(f,+d.i);
  if(d.act==='undelall'||d.act==='undellast'){const fx=f.fix||{};const ks=Object.keys(fx).filter(i=>fx[i]&&fx[i].del);if(!ks.length)return;
    const last=Math.max(...ks.map(i=>fx[i].delAt||0)),pick=d.act==='undelall'?ks:ks.filter(i=>(fx[i].delAt||0)===last);
    const go=()=>{pick.forEach(i=>{const o={...fx[i]};delete o.del;delete o.delAt;if(Object.keys(o).length)fx[i]=o;else delete fx[i]});render()};
    return d.act==='undelall'?ask(`Put back all ${new Set(pick.map(i=>nkey(f.rows.find(r=>r.i==i)))).size} deleted people for ${label(f)}?`,'UNDO ALL',go):go()}
  if(d.act==='del'||d.act==='undel'){const r=f.rows.find(x=>x.i===+d.i);if(!r)return;const same=f.rows.filter(x=>nkey(x)===nkey(r));
    const go=()=>{f.fix=f.fix||{};const at=Date.now();same.forEach(x=>{const o={...(f.fix[x.i]||{})};if(d.act==='del'){o.del=true;o.delAt=at}else{delete o.del;delete o.delAt}if(Object.keys(o).length)f.fix[x.i]=o;else delete f.fix[x.i]});render()};
    if(d.act==='undel')return go();
    const sh=same.reduce((a,x)=>a+(x.tot||0),0),sp=same.reduce((a,x)=>a+(x.pay||0),0);
    return ask(`Delete ${r.name} from ${label(f)}?\n−${f2(sh)} hrs · −${$m(sp)} billing\nUse UNDO LAST DELETE in the Deleted box to put them back.`,'DELETE',()=>{go();alert(`Deleted ${r.name}: −${f2(sh)} hrs · −${$m(sp)}`)})}
}
function weekAgg(W){
  const fs=W.days.filter(x=>x.f).map(x=>x.f);
  const src=fs.length?fs:W.ranges;
  const rows=src.flatMap(rowsFor);
  const A=agg(rows);
  // counts = unique people across week; volume/handshake = sum of day inputs
  const cnt={_t:A.t.head};BUCKETS.forEach(b=>cnt[b]=A.b[b].names.size);
  const ro={};BUCKETS.forEach(b=>{ro[b]={hs:0,hc:0,vol:0};src.forEach(f=>{const I=(S.inputs[f.key]||{})[b];if(I){ro[b].hs+=num(I.hs);ro[b].hc+=num(I.hc);ro[b].vol+=num(I.vol)}})});
  return{A,cnt,ro,src,rows};
}
function summaryView(W){
  const{A,cnt,ro,src,rows}=weekAgg(W);
  const k='WE_'+S.week;
  if(!src.length)return ratePanel()+'<p>No data for this week.</p>';
  let h=ratePanel()+`<div class="sheet">`+repHead('W.E. '+mdy(W.sat));
  const iss=W.days.filter(x=>x.f).map(x=>({d:x.d,I:issues(x.f)})).filter(x=>x.I.openP||x.I.openR||x.I.openL);
  if(iss.length)h+=`<div class="warn noprint"><b>Open timecard issues:</b> ${iss.map(x=>`${DAYS[x.d.getDay()]} ${mdy(x.d).slice(0,5)} — ${[x.I.openP?x.I.openP+' missed punch':'',x.I.openR?x.I.openR+' no bill rate':'',x.I.openL?x.I.openL+' lunch issue'+(x.I.openL>1?'s':''):''].filter(Boolean).join(', ')}`).join(' · ')}</div>`;
  h+=`<div class="rsub">${mdy(W.sun)} – ${mdy(W.sat)} · ${W.days.filter(x=>x.f).length} of 7 days loaded${W.ranges.length?' · period file':''}</div>`;
  h+=sumTable(k,A,{ro,cnt,inv:true});
  h+=`<h3>Daily Hours / Billing</h3><div class="scroll"><table class="orig"><thead><tr><th>Line</th>${W.days.map(x=>`<th>${DAYS[x.d.getDay()]}<br>${mdy(x.d).slice(0,5)}</th>`).join('')}<th>Week</th></tr></thead><tbody>`;
  const per=W.days.map(x=>x.f?agg(rowsFor(x.f)):null);
  BUCKETS.forEach(b=>{if(!A.b[b].tot)return;h+=`<tr><td><b>${b}</b></td>${per.map(p=>`<td>${p?hr(p.b[b].tot):''}</td>`).join('')}<td><b>${hr(A.b[b].tot)}</b></td></tr>`});
  h+=`<tr class="tot"><td>TOTAL HOURS</td>${per.map(p=>`<td>${p?hr(p.t.tot):''}</td>`).join('')}<td>${hr(A.t.tot)}</td></tr>`;
  h+=`<tr class="tot"><td>BILLING</td>${per.map(p=>`<td>${p?$m(p.t.pay):''}</td>`).join('')}<td>${$m(A.t.pay)}</td></tr>`;
  h+=`<tr><td><b>HEADCOUNT</b></td>${per.map(p=>`<td>${p?p.t.head:''}</td>`).join('')}<td><b>${A.t.head}</b></td></tr>`;
  if(W.days.some(x=>x.f&&Object.keys(x.f.ded||{}).length)){
    const pre=priced(()=>W.days.map(x=>x.f?agg(rowsFor(x.f)):null));
    const dh=pre.map((q,n)=>q?q.t.tot-per[n].t.tot:0),d$=pre.map((q,n)=>q?q.t.pay-per[n].t.pay:0),sh=dh.reduce((a,b)=>a+b,0),s$=d$.reduce((a,b)=>a+b,0);
    h+=`<tr><td><b>HANDSHAKE DEDUCTED HRS</b></td>${dh.map(v=>`<td class="${v>.001?'neg':''}">${v>.001?'−'+f2(v):''}</td>`).join('')}<td class="neg"><b>${sh>.001?'−'+f2(sh):'–'}</b></td></tr>`;
    h+=`<tr><td><b>HANDSHAKE DEDUCTED $</b></td>${d$.map(v=>`<td class="${v>.005?'neg':''}">${v>.005?'−'+$m(v):''}</td>`).join('')}<td class="neg"><b>${s$>.005?'−'+$m(s$):'–'}</b></td></tr>`;
  }
  if(W.days.some(x=>x.f&&Object.values(x.f.fix||{}).some(z=>z&&z.del))){
    const D=delImpact(W.days.map(x=>x.f||null)),th=D.reduce((a,x)=>a+x.hrs,0),tp=D.reduce((a,x)=>a+x.pay,0);
    h+=`<tr><td><b>DELETED HRS</b></td>${D.map(x=>`<td class="${x.hrs>.001?'neg':''}">${x.hrs>.001?'−'+f2(x.hrs):''}</td>`).join('')}<td class="neg"><b>${th>.001?'−'+f2(th):'–'}</b></td></tr>`;
    h+=`<tr><td><b>DELETED $</b></td>${D.map(x=>`<td class="${x.pay>.005?'neg':''}">${x.pay>.005?'−'+$m(x.pay):''}</td>`).join('')}<td class="neg"><b>${tp>.005?'−'+$m(tp):'–'}</b></td></tr>`;
  }
  h+=`</tbody></table></div>`;
  h+=`<h3>Notes</h3><textarea class="notes" data-k="${k}" placeholder="Week notes…">${esc((S.inputs[k]||{})._notes||'')}</textarea></div>`;
  const ppl={};rows.forEach(r=>{if(r.adj)return;const p=ppl[r.name]=ppl[r.name]||{t:0,ot:0,dt:0,d:new Set()};p.t+=r.tot;p.ot+=r.ot;p.dt+=(r.dt||0);p.d.add(r.dept)});
  const ot=Object.entries(ppl).filter(([,p])=>p.ot>0||p.dt>0||p.t>40).sort((a,b)=>b[1].t-a[1].t);
  if(ot.length)h+=`<details><summary>OT / 40+ Hour Watch (${ot.length})</summary><div class="in"><table><thead><tr><th>Employee</th><th>Departments</th><th>Total Hrs</th><th>OT Hrs</th><th>DT Hrs</th></tr></thead><tbody>${ot.map(([n,p])=>`<tr><td>${esc(n)}</td><td style="text-align:left">${esc([...p.d].join(', '))}</td><td>${f2(p.t)}</td><td class="ot">${hr(p.ot)}</td><td class="neg">${hr(p.dt)}</td></tr>`).join('')}</tbody></table></div></details>`;
  // week vs handshake: only days that have a handshake entered for that line
  h+=deptDetail(rows,src.flatMap(rawFor));
  return h;
}

/* ---------- export (styled like the original W.E. workbook) ---------- */
const LOGO_B64='';
const XC={$:'"$"#,##0.00',$3:'"$"#,##0.000',h:'#,##0.00;[Red]-#,##0.00',n:'0'};
const THIN={style:'thin',color:{argb:'FF000000'}},MED={style:'medium',color:{argb:'FF000000'}};
function xBox(ws,r1,c1,r2,c2){ // thin grid + medium outline
  for(let r=r1;r<=r2;r++)for(let c=c1;c<=c2;c++){const cell=ws.getCell(r,c);
    cell.border={top:r===r1?MED:THIN,bottom:r===r2?MED:THIN,left:c===c1?MED:THIN,right:c===c2?MED:THIN}}
}
function xSet(ws,addr,val,o={}){
  const c=ws.getCell(addr);c.value=val;
  c.font={name:'Calibri',size:o.sz||11,bold:o.b!==false,color:o.color?{argb:o.color}:undefined};
  c.alignment={horizontal:o.h||'center',vertical:'middle',wrapText:true};
  if(o.fmt)c.numFmt=o.fmt;if(o.fill)c.fill={type:'pattern',pattern:'solid',fgColor:{argb:o.fill}};
  return c;
}
const F=(formula,result)=>({formula,result});
// column map (matches original): A:B dept, C:D count, E reg, F OT, G:H total, I:J billing, L handshake, N volume, O PPH, P CPP, R invoice, S diff
function xHeader(wb,ws,title,dateStr){
  [12,8,9,10,10,10,8,8,10,10,2,12,2,11,9,10,2,13,12].forEach((w,i)=>ws.getColumn(i+1).width=w);
  [1,2,3].forEach(r=>ws.getRow(r).height=28.5);ws.getRow(6).height=31;
  const img=wb.addImage({base64:LOGO_B64,extension:'png'});
  ws.addImage(img,{tl:{col:0.15,row:0.3},ext:{width:330,height:93}});
  ws.mergeCells('A1:G5');xBox(ws,1,1,5,7);
  ws.mergeCells('H1:H3');xSet(ws,'H1','SITE:');ws.mergeCells('I1:J3');xSet(ws,'I1',title,{sz:20});
  ws.mergeCells('H4:H5');xSet(ws,'H4','DATE:');ws.mergeCells('I4:J5');xSet(ws,'I4',dateStr);
  xBox(ws,1,8,3,10);xBox(ws,4,8,5,10);
}
function xBlock(ws,A,opt){ // opt:{cnt, hs(b), vol(b) => value or formula, inv:bool, k}
  const hdr=[['A6:B6','DEPARTMENT'],['C6','ACTIVE\nCOUNT'],['D6','HANDSHAKE\nHC'],['E6','REG\nHOURS'],['F6','OT HOURS'],['G6','DT\nHOURS'],['H6','TOTAL\nHOURS'],['I6:J6','TOTAL\nBILLING'],['L6','HANDSHAKE\nHRS'],['N6','VOLUME'],['O6','PPH'],['P6','CPP']];
  if(opt.inv)hdr.push(['R6','INVOICE $'],['S6','DIFF']);
  hdr.forEach(([rg,t])=>{if(rg.includes(':'))ws.mergeCells(rg);xSet(ws,rg.split(':')[0],t)});
  const bs=BUCKETS.slice();
  let r=7;const first=7;
  bs.forEach(b=>{
    const x=A.b[b],r2=r+1;
    [['A','B'],['C','C'],['D','D'],['E','E'],['F','F'],['G','G'],['H','H'],['I','J'],['L','L'],['N','N'],['O','O'],['P','P']].concat(opt.inv?[['R','R'],['S','S']]:[]).forEach(([c1,c2])=>ws.mergeCells(`${c1}${r}:${c2}${r2}`));
    xSet(ws,'A'+r,b);
    xSet(ws,'C'+r,opt.cnt?opt.cnt[b]:x.names.size,{fmt:XC.n});
    xSet(ws,'E'+r,+x.reg.toFixed(2),{fmt:XC.h});
    xSet(ws,'F'+r,+x.ot.toFixed(2),{fmt:XC.h});
    xSet(ws,'G'+r,+(x.dt||0).toFixed(2),{fmt:XC.h});
    xSet(ws,'H'+r,F(`SUM(E${r}:G${r2})`,+x.tot.toFixed(2)),{fmt:XC.h});
    xSet(ws,'I'+r,+x.pay.toFixed(2),{fmt:XC.$});
    const hs=opt.hs(b,r),vol=opt.vol(b,r);xSet(ws,'D'+r,opt.hc(b,r),{fmt:XC.n});
    xSet(ws,'L'+r,hs,{fmt:'#,##0'});xSet(ws,'N'+r,vol,{fmt:'#,##0'});
    const vv=vol&&typeof vol==='object'?vol.result:vol;
    xSet(ws,'O'+r,F(`IFERROR(N${r}/H${r},0)`,vv&&x.tot?vv/x.tot:0),{b:false,fmt:'0.00'});
    xSet(ws,'P'+r,F(`IFERROR(I${r}/N${r},0)`,vv?x.pay/vv:0),{b:false,fmt:XC.$3});
    if(opt.inv){const iv=(S.inputs[opt.k]||{})[b]||{};const n=iv.inv===''||iv.inv==null?null:num(iv.inv);
      xSet(ws,'R'+r,n,{fmt:XC.$,b:false});xSet(ws,'S'+r,F(`IF(R${r}="","",I${r}-R${r})`,n==null?'':+(x.pay-n).toFixed(2)),{fmt:XC.$})}
    r+=2;
  });
  const last=r-1,T=A.t;
  [['A','B'],['C','C'],['D','D'],['E','E'],['F','F'],['G','G'],['H','H'],['I','J'],['L','L'],['N','N'],['O','O'],['P','P']].concat(opt.inv?[['R','R'],['S','S']]:[]).forEach(([c1,c2])=>ws.mergeCells(`${c1}${r}:${c2}${r+1}`));
  const Y='FFFFF2CC';
  xSet(ws,'A'+r,'TOTALS',{fill:Y});
  xSet(ws,'C'+r,opt.cnt?opt.cnt._t:T.head,{fill:Y});xSet(ws,'D'+r,F(`SUM(D${first}:D${last})`),{fmt:XC.n,fill:Y});
  xSet(ws,'E'+r,F(`SUM(E${first}:E${last})`,+T.reg.toFixed(2)),{fmt:XC.h,fill:Y});
  xSet(ws,'F'+r,F(`SUM(F${first}:F${last})`,+T.ot.toFixed(2)),{fmt:XC.h,fill:Y});
  xSet(ws,'G'+r,F(`SUM(G${first}:G${last})`,+(T.dt||0).toFixed(2)),{fmt:XC.h,fill:Y});
  xSet(ws,'H'+r,F(`SUM(E${r}:G${r+1})`,+T.tot.toFixed(2)),{fmt:XC.h,fill:Y});
  xSet(ws,'I'+r,F(`SUM(I${first}:I${last})`,+T.pay.toFixed(2)),{fmt:XC.$,fill:Y});
  xSet(ws,'L'+r,F(`SUM(L${first}:L${last})`),{fmt:'#,##0',fill:Y});
  xSet(ws,'N'+r,F(`SUM(N${first}:N${last})`),{fmt:'#,##0',fill:Y});
  xSet(ws,'O'+r,F(`IFERROR(N${r}/H${r},0)`),{fmt:'0.00',fill:Y});
  xSet(ws,'P'+r,F(`IFERROR(I${r}/N${r},0)`),{fmt:XC.$3,fill:Y});
  if(opt.inv){xSet(ws,'R'+r,F(`SUM(R${first}:R${last})`),{fmt:XC.$,fill:Y});xSet(ws,'S'+r,F(`SUM(S${first}:S${last})`),{fmt:XC.$,fill:Y})}
  for(let i=7;i<=r+1;i++)ws.getRow(i).height=15.75;
  xBox(ws,6,1,r+1,10);xBox(ws,6,12,r+1,12);xBox(ws,6,14,r+1,16);if(opt.inv)xBox(ws,6,18,r+1,19);
  // notes box
  const nr=r+3;xSet(ws,'A'+nr,'NOTES:',{h:'left',b:true});
  ws.mergeCells(`A${nr+1}:J${nr+8}`);const nc=xSet(ws,'A'+(nr+1),(S.inputs[opt.k]||{})._notes||'',{b:false,h:'left'});nc.alignment={horizontal:'left',vertical:'top',wrapText:true};
  xBox(ws,nr+1,1,nr+8,10);
  return{firstRow:first,totRow:r,bucketRows:Object.fromEntries(bs.map((b,i)=>[b,first+i*2])),next:nr+11};
}
function xSection(ws,row,title){ws.mergeCells(`A${row}:J${row}`);const c=xSet(ws,'A'+row,title,{h:'left',color:'FFFFFFFF',fill:'FF351C15'});return row+1}
function xDetail(ws,row,f){
  row=xSection(ws,row,'TIMECARD DETAIL — '+label(f));
  const cols=[['A','D','EMPLOYEE NAME'],['E','H','DEPARTMENT'],['I','J','LINE'],['K','L','REG'],['M','M','OT'],['N','N','DT'],['O','O','TOTAL'],['P','P','TOTAL PAY'],['Q','S','ADJUSTMENT']];
  cols.forEach(([a,b,t])=>{if(a!==b)ws.mergeCells(`${a}${row}:${b}${row}`);xSet(ws,a+row,t,{fill:'FFE7E6E6'});ws.getCell(a+row).border={top:THIN,bottom:THIN,left:THIN,right:THIN}});
  row++;
  const rows=rowsFor(f).filter(r=>!r.removed&&!r.deleted).sort((a,b)=>a.dept.localeCompare(b.dept)||a.name.localeCompare(b.name));
  rows.forEach(r=>{
    const src=r.i!=null?f.rows.find(x=>x.i===r.i):null;
    const fixNote=r.fixed?'Corrected'+(src&&punchWhy(f,src)?' ('+punchWhy(f,src)+')':'')+(src&&isNoRate(src)?' rate $'+r.rateUsed.toFixed(2):''):r.savedRate?'Saved rate $'+r.rateUsed.toFixed(2):'';
    const openNote=!r.fixed&&src&&!r.moved?(isNoRate(src)&&r.salary==null&&!r.savedRate&&!((f.fix||{})[r.i]||{}).ok?'NO BILL RATE':punchWhy(f,src)&&!((f.fix||{})[r.i]||{}).ok?'MISSED PUNCH? '+punchWhy(f,src):''):'';
    const note0=r.deleted?'Deleted from report':r.removed?'Removed — over handshake HC ('+f2(r.base)+' hrs)':r.moved?'Moved from '+r.from:r.adj?(r.tot<0?'Moved to '+r.to:'Moved from '+r.from):r.trimmed?'Deducted '+f2(r.trimmed)+' hrs — over handshake hrs':r.added?'Added '+f2(r.added)+' hrs':r.touched?'Partly moved':'';
    const salNote=r.salary!=null?'Salary $'+f2(r.salary)+'/day'+(r.sdays>1?' × '+r.sdays+' days':''):'';
    const note=[note0,fixNote,salNote,openNote].filter(Boolean).join(' · ');const noteX=note;
    const v=[r.name,r.dept,r.bucket,+r.reg.toFixed(2),+r.ot.toFixed(2),+(r.dt||0).toFixed(2),+r.tot.toFixed(2),+r.pay.toFixed(2),noteX];
    cols.forEach(([a,b],i)=>{if(a!==b)ws.mergeCells(`${a}${row}:${b}${row}`);
      const c=xSet(ws,a+row,v[i],{b:false,h:i<3||i===8?'left':'right',fmt:i===7?XC.$:i>2&&i<7?XC.h:undefined,fill:openNote?'FFFFFF00':r.removed||r.trimmed?'FFFCE4D6':note?'FFE2F0D9':undefined});
      c.border={top:THIN,bottom:THIN,left:THIN,right:THIN}});
    row++;
  });
  return row+1;
}
const tabName=f=>f.single?DAYS[f.start.getDay()]+' '+mdy(f.start).slice(0,5):'Period '+mdy(f.start).slice(0,5)+'-'+mdy(f.end).slice(0,5);
document.getElementById('btnXlsx').onclick=async()=>{
  if(!S.files.length)return alert('Drop a timecard first.');
  if(typeof ExcelJS==='undefined')return alert('Excel library did not load — check your internet connection and reload.');
  const W=weekFiles(),wb=new ExcelJS.Workbook(),t=siteTitle();
  const dayRef=[]; // {name,map}
  const addDay=f=>{
    const nm=tabName(f),ws=wb.addWorksheet(nm,{views:[{showGridLines:false}],pageSetup:{orientation:'landscape',fitToPage:true,fitToWidth:1,fitToHeight:0}});
    xHeader(wb,ws,t,f.single?mdy(f.start):mdy(f.start)+' - '+mdy(f.end));
    const A=agg(rowsFor(f));
    const I=b=>(S.inputs[f.key]||{})[b]||{};
    const out=xBlock(ws,A,{k:f.key,hs:b=>num(I(b).hs)||null,hc:b=>num(I(b).hc)||null,vol:b=>num(I(b).vol)||null});
    xDetail(ws,out.next,f);
    dayRef.push({nm,map:out.bucketRows});
  };
  W.days.forEach(x=>{if(x.f)addDay(x.f)});
  W.ranges.forEach(addDay);
  // WEEK TOTAL — last tab
  const ws=wb.addWorksheet('WEEK TOTAL',{views:[{showGridLines:false}],properties:{tabColor:{argb:'FFF5B400'}},pageSetup:{orientation:'landscape',fitToPage:true,fitToWidth:1,fitToHeight:0}});
  xHeader(wb,ws,t,'W.E. '+mdy(W.sat));
  const{A,cnt,ro}=weekAgg(W);
  const sumRef=(b,col)=>dayRef.filter(d=>d.map[b]).map(d=>`'${d.nm}'!${col}${d.map[b]}`).join('+');
  const out=xBlock(ws,A,{k:'WE_'+S.week,cnt,inv:true,
    hs:b=>{const f=sumRef(b,'L');return f?F(f,ro[b].hs||0):null},
    hc:b=>{const f=sumRef(b,'D');return f?F(f,ro[b].hc||0):null},
    vol:b=>{const f=sumRef(b,'N');return f?F(f,ro[b].vol||0):null}});
  // daily matrix
  let row=xSection(ws,out.next,'DAILY HOURS / BILLING');
  const dcols=['C','D','E','F','G','H','I'];
  xSet(ws,'A'+row,'LINE',{fill:'FFE7E6E6'});ws.mergeCells(`A${row}:B${row}`);
  W.days.forEach((x,i)=>xSet(ws,dcols[i]+row,DAYS[x.d.getDay()]+' '+mdy(x.d).slice(0,5),{fill:'FFE7E6E6',sz:9}));
  ws.mergeCells(`J${row}:J${row}`);xSet(ws,'J'+row,'WEEK',{fill:'FFE7E6E6'});
  const hdrRow=row;row++;
  const per=W.days.map(x=>x.f?agg(rowsFor(x.f)):null);
  const line=(lbl,fn,fmt,bold)=>{ws.mergeCells(`A${row}:B${row}`);xSet(ws,'A'+row,lbl,{h:'left'});
    let s=0;per.forEach((p,i)=>{const v=p?fn(p):null;if(v!=null)s+=v;xSet(ws,dcols[i]+row,v==null?null:+v.toFixed(2),{b:!!bold,fmt})});
    xSet(ws,'J'+row,+s.toFixed(2),{fmt});row++};
  BUCKETS.forEach(b=>{if(A.b[b].tot||A.b[b].pay)line(b,p=>p.b[b].tot,XC.h)});
  line('TOTAL HOURS',p=>p.t.tot,XC.h,true);
  line('BILLING',p=>p.t.pay,'"$"#,##0',true);
  ws.mergeCells(`A${row}:B${row}`);xSet(ws,'A'+row,'HEADCOUNT',{h:'left'});per.forEach((p,i)=>xSet(ws,dcols[i]+row,p?p.t.head:null));xSet(ws,'J'+row,A.t.head);row++;
  xBox(ws,hdrRow,1,row-1,10);
  wb.views=[{activeTab:wb.worksheets.length-1}];
  const buf=await wb.xlsx.writeBuffer();
  const code=(t.replace(/^MULTI-SITE.*/,'MULTI')||siteLbl()).replace(/[^\w]/g,'');
  await saveFile(`${code}_W.E._${mdy(W.sat)}.xlsx`,new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}));
};
document.getElementById('btnPrint').onclick=()=>window.print();
document.getElementById('btnClear').onclick=()=>ask('Clear ALL saved days, handshake entries and notes?\n(Saved bill rates and salaries are kept.)','CLEAR ALL',()=>{S.files=[];S.inputs={};S.sites.clear();S.seen.clear();S.tab=null;S.week=null;render();alert('Cleared.')});
document.getElementById('week').onchange=e=>{S.week=e.target.value;S.tab=null;render()};
document.getElementById('siteName').onchange=()=>render();
/* ---------- SAVE: one state for the page, merged per day (newest edit wins) ----------
   Where it's kept:  this browser (auto) · the page itself (claude.ai: SAVE publishes it for everyone;
   anywhere: SAVE HTML downloads a copy of this page with the data inside) · optional Google shared file. */
const SRC={style:(document.getElementById('tt-style')||{}).textContent||'',app:(document.getElementById('app')||{}).outerHTML||'',main:(document.currentScript&&document.currentScript.textContent)||(document.getElementById('tt-main')||{}).textContent||''};
S.imod={};S.gone={};
let RMOD=(()=>{try{return +localStorage.getItem('tt_rmod')||0}catch(e){return 0}})();
let FP=null; // fingerprints of last known state
const fpRates=()=>JSON.stringify([LRATE,MU,DEPTMAP,RATES]);
function fpDays(){const o={};S.files.forEach(f=>o['F:'+f.key]=JSON.stringify([f.rows.length,f.fix||{},f.ded||{},f.name]));Object.entries(S.inputs).forEach(([k,v])=>o['I:'+k]=JSON.stringify(v));return o}
function track(baseline){ // stamp what changed since last look
  const now=Date.now(),d=fpDays(),r=fpRates();
  if(FP&&!baseline){
    Object.entries(d).forEach(([k,v])=>{if(FP.d[k]!==v){if(k[0]==='F'){const f=S.files.find(x=>'F:'+x.key===k);if(f)f.mod=now}else S.imod[k.slice(2)]=now}});
    Object.keys(FP.d).forEach(k=>{if(!(k in d)&&k[0]==='F')S.gone[k.slice(2)]=now});
    if(FP.r!==r){RMOD=now;try{localStorage.setItem('tt_rmod',String(now))}catch(e){}}
  }
  FP={d,r};
}
function payload(){
  track();
  return{app:'tiktok-we',v:3,savedAt:new Date().toISOString(),site:document.getElementById('siteName').value,
    days:{files:S.files.map(f=>({name:f.name,start:iso(f.start),end:iso(f.end),single:f.single,key:f.key,rows:f.rows,fix:f.fix||{},ded:f.ded||{},dedRes:f.dedRes||null,mod:f.mod||0})),inputs:S.inputs,imod:S.imod,gone:S.gone},
    payRates:LRATE,markup:MU,deptmap:DEPTMAP,assocRates:RATES,ratesMod:RMOD};
}
function norm(p){ // accept every format this tool has written
  if(!p||typeof p!=='object')return null;
  if(p.app==='tiktok-we'&&p.days&&!p.days.imod){p={...p,days:{...p.days,imod:{},gone:{}}}}
  if(p.app==='tiktok-we')return p;
  if(Array.isArray(p.files))return{app:'tiktok-we',v:1,savedAt:p.saved||'',days:{files:p.files,inputs:p.inputs||{},imod:{},gone:{}},ratesMod:0};
  return null;
}
function merge(a,b){ // per day / per entry: newest edit wins; deleted days stay deleted
  a=norm(a);b=norm(b);if(!a)return b;if(!b)return a;
  const gone={...a.days.gone};Object.entries(b.days.gone||{}).forEach(([k,t])=>{if(!(gone[k]>=t))gone[k]=t});
  const fs={};[a,b].forEach(p=>(p.days.files||[]).forEach(f=>{const c=fs[f.key];if(!c||(f.mod||0)>=(c.mod||0))fs[f.key]=f}));
  const files=Object.values(fs).filter(f=>!(gone[f.key]>(f.mod||0)));
  const inputs={},imod={};[a,b].forEach(p=>Object.entries(p.days.inputs||{}).forEach(([k,v])=>{const t=(p.days.imod||{})[k]||0;if(!(k in inputs)||t>=imod[k]){inputs[k]=v;imod[k]=t}}));
  const rb=(b.ratesMod||0)>=(a.ratesMod||0)?b:a,ra=rb===b?a:b;
  return{app:'tiktok-we',v:3,savedAt:(a.savedAt>b.savedAt?a.savedAt:b.savedAt)||'',site:b.site||a.site,days:{files,inputs,imod,gone},
    payRates:rb.payRates||ra.payRates,markup:rb.markup||ra.markup,deptmap:{...(ra.deptmap||{}),...(rb.deptmap||{})},assocRates:{...(ra.assocRates||{}),...(rb.assocRates||{})},ratesMod:Math.max(a.ratesMod||0,b.ratesMod||0)};
}
function apply(p){
  p=norm(p);if(!p)return;
  const toDate=x=>new Date(x+'T00:00:00');
  S.files=(p.days.files||[]).map(x=>({...x,start:toDate(x.start),end:toDate(x.end),moves:[]}));
  S.inputs=p.days.inputs||{};S.imod=p.days.imod||{};S.gone=p.days.gone||{};
  if(p.payRates){const pr={...p.payRates};Object.keys(LRATE).forEach(k=>delete LRATE[k]);Object.assign(LRATE,Object.keys(pr).length?pr:PAY_DEF);LSs('tt_payrates',LRATE)}
  if(p.markup){MU.pct=p.markup.pct;LSs('tt_markup',MU)}
  if(p.deptmap){Object.assign(DEPTMAP,p.deptmap);LSs('tt_deptmap',DEPTMAP)}
  if(p.assocRates){Object.assign(RATES,p.assocRates);saveRates()}
  RMOD=p.ratesMod||RMOD;try{localStorage.setItem('tt_rmod',String(RMOD))}catch(e){}
  if(p.site)document.getElementById('siteName').value=p.site;
  const wk=[...new Set(S.files.map(f=>iso(weSat(f.end))))].sort();if(!wk.includes(S.week)){S.week=wk[wk.length-1]||null;S.tab=null}
  track(true);
}
const setStat=(t,bad)=>{const st=document.getElementById('saveStat');st.textContent=t;st.className='savestat'+(bad?' bad':'')};
const hhmm=d=>new Date(d).toLocaleString([],{month:'numeric',day:'numeric',hour:'numeric',minute:'2-digit'});
let saveT=null,lastSaved='',PUBLISHED=null; // PUBLISHED = state everyone currently sees
function unsaved(){if(!PUBLISHED)return false;const t=Date.parse(PUBLISHED.savedAt)||0;return S.files.some(f=>(f.mod||0)>t)||Object.values(S.imod).some(x=>x>t)||Object.values(S.gone).some(x=>x>t)||RMOD>t}
function saveNow(){ // this browser, automatic
  try{const j=JSON.stringify(payload());if(j!==lastSaved){localStorage.setItem('tt_days',j);lastSaved=j}
    if(SHARED_URL&&!ART){if(unsaved()&&!SYNCING){setStat('● changes not saved yet — auto-saving…',true);autoSync()}return true}
    if(ART){if(unsaved())setStat('● unsaved changes — hit SAVE so everyone sees them',true);return true}
    if(NETDIAG){setStat('⚠ not connected to the save server — saved in this browser only',true);return true}
    const n=S.files.length;setStat(n?`✓ ${n} day${n>1?'s':''} kept in this browser`:'');return true;
  }catch(e){setStat('⚠ this browser won\'t keep data — use SAVE HTML',true);return false}
}
/* files out: works on Netlify / local file (link) and inside claude.ai (downloads capability) */
let DL=null,ART=null;
async function saveFile(name,data,mime){
  const blob=data instanceof Blob?data:new Blob([data],{type:mime||'application/octet-stream'});
  if(DL){try{await DL.save({filename:name,data:blob})}catch(e){if(e&&e.code!=='declined')alert('Download not available here ('+(e.code||e.message)+').')}return}
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},1500);
}
const jsonSafe=o=>JSON.stringify(o).replace(/</g,'\\u003c');
function pageHTML(p){
  return'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TikTok W.E. Report</title><style id="tt-style">'+SRC.style+'</style></head><body>'+SRC.app+
    '<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"><\/script><script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"><\/script>'+
    '<script type="application/json" id="tt-state">'+jsonSafe(p)+'<\/script><script id="tt-main">'+SRC.main+'<\/script></body></html>';
}
async function saveHTML(){
  const p=payload(),n=p.days.files.length;
  await saveFile('TikTok_WE_Report.html',pageHTML(p),'text/html');
  alert(`HTML saved with ${n} day${n===1?'':'s'} inside — open it (or upload it to Netlify) and the data is there.`);
}
function backupFile(){saveFile('TikTok_WE_Backup_'+iso(new Date())+'.json',JSON.stringify(payload()),'application/json')}
/* ---------- Google shared file (optional, for Netlify) ---------- */
const SHARED_DEFAULT=''; // paste the Apps Script /exec URL here to build it in for everyone
let SHARED_URL=(()=>{try{return localStorage.getItem('tt_shared_url')||SHARED_DEFAULT}catch(e){return SHARED_DEFAULT}})();
let NETLIFY=false,NETDIAG='';
/* ---------- GITHUB SAVE: one JSON file in a GitHub repo, read/written with the GitHub Contents API ----------
   Fill these in once (in GitHub's editor) and everyone who opens the page saves to the same file.
   token = a fine-grained personal access token limited to ONLY the data repo, permission "Contents: Read and write". */
const GITHUB_SAVE={owner:'',repo:'',branch:'',path:'tiktok_we_state.json',token:''};
let GH=(()=>{const ok=o=>o&&o.owner&&o.repo&&o.token;try{const o=JSON.parse(localStorage.getItem('tt_gh')||'null');if(ok(o))return{...GITHUB_SAVE,...o}}catch(e){}return ok(GITHUB_SAVE)?{...GITHUB_SAVE}:null})();
let GH_SHA=null;
const ghURL=()=>`https://api.github.com/repos/${encodeURIComponent(GH.owner)}/${encodeURIComponent(GH.repo)}/contents/${(GH.path||'tiktok_we_state.json').split('/').map(encodeURIComponent).join('/')}`;
const ghRef=()=>GH.branch?'ref='+encodeURIComponent(GH.branch)+'&':'';
const ghH=acc=>({Authorization:'Bearer '+GH.token,Accept:acc||'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'});
const b64e=str=>{const b=new TextEncoder().encode(str);let o='';for(let i=0;i<b.length;i+=0x8000)o+=String.fromCharCode.apply(null,b.subarray(i,i+0x8000));return btoa(o)};
const b64d=str=>new TextDecoder().decode(Uint8Array.from(atob(str.replace(/\s/g,'')),c=>c.charCodeAt(0)));
function ghErr(r,what){
  if(r.status===401)return new Error('GitHub token was rejected — it may have expired. Make a new one and update ⚙ SHARED.');
  if(r.status===403)return new Error('GitHub refused access — the token needs "Contents: Read and write" on '+GH.owner+'/'+GH.repo+'.');
  if(r.status===404)return new Error('GitHub repo '+GH.owner+'/'+GH.repo+(GH.branch?' (branch '+GH.branch+')':'')+' not found, or the token can\'t see it.');
  return new Error('GitHub '+what+' failed ('+r.status+')');
}
async function ghGet(){
  const r=await fetch(ghURL()+'?'+ghRef()+'t='+Date.now(),{headers:ghH(),cache:'no-store'});
  if(r.status===404){ // file not made yet — check the repo itself is reachable
    const rr=await fetch(`https://api.github.com/repos/${encodeURIComponent(GH.owner)}/${encodeURIComponent(GH.repo)}`,{headers:ghH(),cache:'no-store'});
    if(!rr.ok)throw ghErr(rr,'load');GH_SHA=null;return{};
  }
  if(!r.ok)throw ghErr(r,'load');
  const j=await r.json();GH_SHA=j.sha;
  if(j.encoding==='base64'&&j.content)return JSON.parse(b64d(j.content)||'{}');
  const r2=await fetch(ghURL()+'?'+ghRef()+'t='+Date.now(),{headers:ghH('application/vnd.github.raw+json'),cache:'no-store'}); // files over 1 MB
  if(!r2.ok)throw ghErr(r2,'load');const t=await r2.text();return JSON.parse(t||'{}');
}
async function ghPut(obj){
  const body={message:'TikTok W.E. save · '+new Date().toLocaleString(),content:b64e(JSON.stringify(obj))};
  if(GH_SHA)body.sha=GH_SHA;if(GH.branch)body.branch=GH.branch;
  const r=await fetch(ghURL(),{method:'PUT',headers:{...ghH(),'Content-Type':'application/json'},body:JSON.stringify(body)});
  if(r.status===409||(r.status===422&&!GH_SHA)||(r.status===422&&/sha/i.test(await r.clone().text()))){const e=new Error('someone else saved at the same moment');e.conflict=true;throw e}
  if(!r.ok)throw ghErr(r,'save');
  const j=await r.json();GH_SHA=j.content&&j.content.sha;return{ok:true};
} // true when this site's own /api/state save function answers (GitHub-connected Netlify)
async function sharedGet(){if(GH)return ghGet();const r=await fetch(SHARED_URL+(SHARED_URL.includes('?')?'&':'?')+'t='+Date.now(),{cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);const t=await r.text();try{return JSON.parse(t||'{}')}catch(e){throw new Error(NETLIFY?'save function returned a page, not data':'not the shared-save script — check the URL and that access is "Anyone"')}}
async function sharedPost(obj){if(GH)return ghPut(obj);const r=await fetch(SHARED_URL,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(obj)});if(!r.ok)throw new Error('HTTP '+r.status);const j=JSON.parse(await r.text());if(!j.ok)throw new Error(j.error||'save failed');return j}
async function sharedLoad(quiet){
  if(!SHARED_URL)return;setStat('⟳ loading shared data…');
  try{const d=norm(await sharedGet());if(d){PUBLISHED=d;apply(merge(d,payload()));render()}else if(!PUBLISHED){PUBLISHED={savedAt:new Date(0).toISOString()};saveNow()}
    setStat(d?(unsaved()?'● unsaved changes — hit SAVE so everyone sees them':`✓ up to date · saved ${hhmm(d.savedAt)}`):(GH?`✓ GitHub connected (${GH.owner}/${GH.repo}) — nothing saved yet`:NETLIFY?'✓ connected — nothing saved yet':'shared save connected — nothing saved yet'),unsaved());
    if(!quiet)alert('Loaded latest shared data.');
  }catch(e){setStat('⚠ shared load failed — '+e.message,true)}
}
/* ---------- SAVE ---------- */
let AUTO_T=null,SYNCING=false;
async function sharedSave(quiet){
  if(SYNCING){if(!quiet)alert('Already saving — one moment.');return}
  SYNCING=true;setStat(quiet?'⟳ auto-saving…':'⟳ saving…');
  try{let p;for(let tries=0;;tries++){
      const cur=norm(await sharedGet());if(cur){apply(merge(cur,payload()));render()}
      p=payload();try{await sharedPost(p);break}catch(e){if(!e.conflict||tries>=2)throw e}}
    PUBLISHED=p;SYNCING=false;saveNow();
    const n=p.days.files.length;setStat(`✓ saved for everyone ${hhmm(p.savedAt)} · ${n} day${n===1?'':'s'}${GH?' · GitHub':''}`);
    if(!quiet)alert(`✓ Saved — everyone with the link now sees ${n} day${n===1?'':'s'}.`);
  }catch(e){SYNCING=false;setStat('⚠ save failed — '+e.message+(quiet?' · will retry':''),true);
    if(!quiet)alert('Save failed: '+e.message+'. Your data is still kept in this browser — try again.');else{clearTimeout(AUTO_T);AUTO_T=setTimeout(autoSync,30000)}}
}
function autoSync(){ // GitHub/Netlify (or Google) save server: push changes a few seconds after they stop
  if(!SHARED_URL||ART)return;clearTimeout(AUTO_T);
  AUTO_T=setTimeout(()=>{if(unsaved()&&!SYNCING)sharedSave(true)},GH?8000:2500);
}
async function saveAll(){
  if(ART){ // claude.ai: the page publishes its data — every viewer gets it
    setStat('⟳ saving…');const p=payload();
    try{sessionStorage.setItem('tt_pending','1')}catch(e){}
    try{await ART.publish({'data/state.json':{content:JSON.stringify(p),contentType:'application/json'}});
      try{sessionStorage.removeItem('tt_pending')}catch(e){}
      PUBLISHED=p;saveNow();const n=p.days.files.length;setStat(`✓ saved for everyone ${hhmm(p.savedAt)} · ${n} day${n===1?'':'s'}`);alert(`✓ Saved — everyone who opens this page now sees ${n} day${n===1?'':'s'}.`);
    }catch(e){try{sessionStorage.removeItem('tt_pending')}catch(x){}
      const c=e&&e.code;
      if(c==='conflict')return; // someone saved first: page reloads, your edits come back from this browser
      if(c==='not_writer'||c==='not_granted')alert('You can view this page but not save it — ask the owner for edit access. Your changes are kept in this browser.');
      else alert('Saving to the page isn\'t available here. Your changes are kept in this browser.');
      setStat('● not saved for everyone',true)}
    return;
  }
  if(SHARED_URL){clearTimeout(AUTO_T);return sharedSave(false)}
  // no save server reached: keep it in this browser and say why others can't see it
  clearTimeout(saveT);lastSaved='';saveNow();
  setStat('⚠ not connected to the save server — saved in this browser only',true);
  alert(NETDIAG||'Saved in this browser only — this page isn\'t connected to the Netlify save server, so others can\'t see it yet.');
}
document.getElementById('btnSave').onclick=saveAll;
document.getElementById('btnSaveHtml').onclick=saveHTML;
document.getElementById('btnBackup').onclick=backupFile;
document.getElementById('btnShared').onclick=()=>{
  if(ART)return alert('On claude.ai, SAVE already saves the page for everyone — no setup needed.');
  const g=GH||GITHUB_SAVE,dlg=document.getElementById('dlg');
  dlg.innerHTML=`<div class="card" style="max-width:520px"><h3 style="margin-top:0">SHARED SAVE — GITHUB</h3>
    <p style="margin:0 0 6px;color:var(--mute);font-size:13px">Saved data goes into one file in a GitHub repo. Everyone using the same settings sees the same days, rates and notes.</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
     <label>OWNER (account / org)<input id="ghOwner" value="${esc(g.owner)}" placeholder="chuckdavid"></label>
     <label>DATA REPO<input id="ghRepo" value="${esc(g.repo)}" placeholder="tiktok-we-data"></label>
     <label>FILE<input id="ghPath" value="${esc(g.path||'tiktok_we_state.json')}"></label>
     <label>BRANCH (blank = default)<input id="ghBranch" value="${esc(g.branch||'')}" placeholder="main"></label></div>
    <label>TOKEN (fine-grained, this repo only, Contents: Read and write)<input id="ghTok" type="password" value="${esc(g.token)}" placeholder="github_pat_…"></label>
    <div id="ghMsg" class="hint" style="margin-top:6px"></div>
    <div style="display:flex;gap:8px;justify-content:space-between;margin-top:10px;flex-wrap:wrap"><span>${GH?'<button id="shLoad">⟳ LOAD LATEST</button> <button class="mini x" id="shOff">DISCONNECT</button>':''}</span><span><button id="shNo">CANCEL</button> <button class="pri" id="shGo">TEST &amp; CONNECT</button></span></div>
    ${GH&&!GITHUB_SAVE.token?`<details style="margin-top:8px"><summary style="font-size:12px">Make it built-in for everyone</summary><div class="hint">In GitHub, edit <b>index.html</b>, find the line starting with <code>const GITHUB_SAVE=</code> and replace it with the line below. Then nobody has to type these settings.</div><textarea id="ghLine" readonly style="width:100%;height:58px;font:11px monospace">const GITHUB_SAVE=${esc(JSON.stringify({owner:g.owner,repo:g.repo,branch:g.branch||'',path:g.path||'tiktok_we_state.json',token:g.token}))};</textarea><button class="mini" id="ghCopy">COPY LINE</button></details>`:''}</div>`;
  dlg.style.display='flex';const close=()=>{dlg.style.display='none'};
  document.getElementById('shNo').onclick=close;dlg.onclick=e=>{if(e.target===dlg)close()};
  const L=document.getElementById('shLoad');if(L)L.onclick=()=>{close();sharedLoad(false)};
  const C=document.getElementById('ghCopy');if(C)C.onclick=()=>{const t=document.getElementById('ghLine');t.select();try{navigator.clipboard.writeText(t.value).then(()=>alert('Copied.'),()=>{})}catch(e){}};
  const O=document.getElementById('shOff');if(O)O.onclick=()=>{GH=null;GH_SHA=null;SHARED_URL='';PUBLISHED=null;try{localStorage.removeItem('tt_gh');localStorage.setItem('tt_shared_url','')}catch(e){}close();btnLabels();saveNow()};
  document.getElementById('shGo').onclick=async()=>{
    const v=id=>document.getElementById(id).value.trim(),cfg={owner:v('ghOwner'),repo:v('ghRepo'),path:v('ghPath')||'tiktok_we_state.json',branch:v('ghBranch'),token:v('ghTok')};
    const m=document.getElementById('ghMsg');if(!cfg.owner||!cfg.repo||!cfg.token){m.innerHTML='<b class="neg">Owner, repo and token are all needed.</b>';return}
    const keep=GH;GH=cfg;m.textContent='Checking GitHub…';
    try{await ghGet();try{localStorage.setItem('tt_gh',JSON.stringify(cfg))}catch(e){}SHARED_URL='github:'+cfg.owner+'/'+cfg.repo;PUBLISHED=null;close();btnLabels();await sharedLoad(false)}
    catch(e){GH=keep;m.innerHTML='<b class="neg">'+esc(e.message)+'</b>'}
  };
};
function btnLabels(){
  document.getElementById('btnSave').textContent=ART||NETLIFY||GH?'SAVE':SHARED_URL?'SAVE (SHARED)':'SAVE';
  document.getElementById('btnShared').textContent=GH?'⚙ GITHUB ✓':'⚙ SHARED';
  document.getElementById('btnSave').title=ART||NETLIFY||GH?'Save so everyone with the link sees it':SHARED_URL?'Save to the shared Google file':'Keep in this browser and download this page with the data inside';
  document.getElementById('btnShared').hidden=!!ART;document.getElementById('btnPrint').hidden=!!window.claude;
}
const _render=render;
render=function(){reprice();_render();clearTimeout(saveT);saveT=setTimeout(saveNow,400)};
document.addEventListener('input',()=>{clearTimeout(saveT);saveT=setTimeout(saveNow,800)},true);
window.addEventListener('beforeunload',saveNow);
/* ---------- startup: data inside this HTML + this browser, then the shared copy ---------- */
(function boot(){
  let emb=null;try{const el=document.getElementById('tt-state');if(el&&el.textContent.trim())emb=norm(JSON.parse(el.textContent))}catch(e){}
  let loc=null;try{loc=norm(JSON.parse(localStorage.getItem('tt_days')||'null'))}catch(e){}
  if(emb)PUBLISHED=emb;
  const start=merge(emb,loc);if(start)apply(start);
  render();btnLabels();
  if(emb&&!loc&&S.files.length)setStat(`✓ loaded ${S.files.length} saved day${S.files.length===1?'':'s'} from this page (${hhmm(emb.savedAt)})`);
  if(window.claude&&claude.use){
    claude.use('downloads').then(d=>{DL=d}).catch(()=>{});
    claude.use('artifact').then(async a=>{if(!a)return;ART=a;btnLabels();
      try{const r=await fetch('data/state.json',{cache:'no-store'});if(r.ok){const p=norm(await r.json());if(p&&p.days){PUBLISHED=p;apply(merge(p,payload()));render()}}}catch(e){}
      let pend=false;try{pend=sessionStorage.getItem('tt_pending')==='1';sessionStorage.removeItem('tt_pending')}catch(e){}
      if(pend)alert('Someone else saved first — their changes are loaded and yours are kept. Hit SAVE again.');
      saveNow();if(!unsaved()&&PUBLISHED)setStat(`✓ up to date · saved ${hhmm(PUBLISHED.savedAt)}`);
    }).catch(()=>{});
  }
  if(GH&&!window.claude){SHARED_URL='github:'+GH.owner+'/'+GH.repo;btnLabels();sharedLoad(true);setInterval(()=>{if(!unsaved()&&!SYNCING&&document.visibilityState==='visible')sharedLoad(true)},60000)}
  // GitHub-connected Netlify: this site's own save function at /api/state
  else if(/^https?:$/.test(location.protocol)&&!window.claude){
    fetch('/api/state?probe=1',{cache:'no-store'}).then(async r=>{
      const ct=r.headers.get('content-type')||'';
      if(r.ok&&ct.includes('json')){NETLIFY=true;SHARED_URL='/api/state';btnLabels();await sharedLoad(true);setInterval(()=>{if(!unsaved()&&document.visibilityState==='visible')sharedLoad(true)},120000)}
      else{NETDIAG=`Saved in this browser only. The Netlify save server didn't answer (${location.host}/api/state gave ${r.status}${r.ok?' but not data':''}). This site was deployed without the save function — deploy it from the GitHub repo (index.html + netlify folder + package.json + netlify.toml), not by drag-and-drop.`;
        if(SHARED_URL)sharedLoad(true);else setStat('⚠ not connected to the save server — SAVE keeps data in this browser only',true)}
    }).catch(()=>{NETDIAG='Saved in this browser only — the save server could not be reached.';if(SHARED_URL)sharedLoad(true)});
  }else{if(!window.claude)NETDIAG='Saved in this browser only — this file is opened from your computer, not from the Netlify link. Open the Netlify link to save for everyone.';if(SHARED_URL)sharedLoad(true)}
})();
</script>
</body>
</html>